# ============================================================
# booking（api 预约主系统）环境变量模板
#
# ⚠️⚠️ 本文件是 **同步副本**，正本在 api/beforeRun/booking.env.template
#      （deploy/upload-to-server.sh 与全部部署手册引用的都是正本）
#      改一处必须两处一起改 —— 守卫 check:secret-env 只校验正本，
#      副本漂移不会报错。历史上这里就是漂移过的：正本早已改成 AES_KEY，
#      副本还留着 CRYPTO_AESKEY（无效名，注入等于没注入，且不报错）。
#
# 用法：sudo cp booking.env.template /etc/lesson/booking.env
#       sudo chmod 600 /etc/lesson/booking.env && sudo chown lesson:lesson /etc/lesson/booking.env
# systemd 单元用 EnvironmentFile=/etc/lesson/booking.env 注入
# ------------------------------------------------------------
# 密钥配对关系（务必与 message.env / classroom.env 逐字符一致）：
#   JWT_SECRET → jwt.secret      api 签发+校验；message / classroom 仅校验（共享密钥域）
#   AES_KEY    → crypto.aes-key  AES-256-GCM 字段加解密；三服务须互通
#   HMAC_KEY   → crypto.hmac-key HMAC-SHA256 搜索索引；同上须互通
#   前端（dist）不持有任何密钥，仅转发 token。
#
# ⚠️ 变量名为什么必须是 AES_KEY / HMAC_KEY（2026-10-30 实测澄清）：
#   properties 里写的是 `crypto.aes-key=${AES_KEY:内置默认值}`，
#   @Value("${crypto.aes-key}") 取到属性值后还要做**占位符解析**，
#   这一步逐字查环境变量 `AES_KEY`。
#   ● 写成 `CRYPTO_AESKEY` → 逐字对不上，占位符落到默认值 → 静默用仓库公开密钥（不报错！）
#   ● 写成 `AES_KEY`       → 正确
#   ● `CRYPTO_AES_KEY` 也**碰巧**有效（Spring 查环境变量时会把它规范化成这个名字），
#     但它只是巧合命中，别依赖；统一用 AES_KEY / HMAC_KEY。
# ============================================================

DB_USERNAME=lesson
DB_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/lesson_appointment?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# ≥64 字符的随机串；若接续本地已有环境，直接粘贴本地现有值，不要重新生成
JWT_SECRET=CHANGE_ME
# 32 字节随机数 Base64（44 字符带 =）；须与 message.env / classroom.env 相同
AES_KEY=CHANGE_ME
# 32 字节随机数 Base64；须与 message.env / classroom.env 相同
HMAC_KEY=CHANGE_ME

# ===== 微信 appid / appsecret（2026-10-14 新增；仅 booking 主系统用，其它 env 不要加）=====
# 小程序 AppID / AppSecret：微信公众平台 → 开发管理 → 开发设置
WECHAT_APPID=wxc4f96c9bd2351015
WECHAT_SECRET=CHANGE_ME
# 开放平台网站应用（PC 扫码登录 P2）：微信开放平台 → 管理中心 → 网站应用
WECHAT_OPEN_APPID=CHANGE_ME
WECHAT_OPEN_SECRET=CHANGE_ME
# 回调域：须与开放平台「网站应用 → 授权回调域」一致（只填域名，不带 path），生产用已备案 HTTPS
WECHAT_OPEN_REDIRECT_URI=https://booking.example.com/api/v1/auth/wechat/pc-callback

JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8

# 日志落盘目录（不设 → logback 退化成 ./logs，落到 /opt/lesson/logs/，与运维约定错位）
LOG_PATH=/var/log/lesson/api

# 显式声明监听端口（防止外部 SERVER_PORT/SERVER__PORT 把 8081 改掉）
SERVER_PORT=8081
