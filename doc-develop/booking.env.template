# ============================================================
# booking（api 预约主系统）环境变量模板
# 用法：sudo cp booking.env.template /etc/lesson/booking.env
#       sudo chmod 600 /etc/lesson/booking.env && sudo chown lesson:lesson /etc/lesson/booking.env
# systemd 单元用 EnvironmentFile=/etc/lesson/booking.env 注入
# ------------------------------------------------------------
# 密钥配对关系（务必与 message.env 逐字符一致）：
#   JWT_SECRET     → jwt.secret      api 签发+校验；message-service 仅校验（共享密钥域）
#   CRYPTO_AESKEY  → crypto.aes-key  AES-256-GCM 字段加解密；两服务共用 message_center 库，须互通
#   CRYPTO_HMACKEY → crypto.hmac-key HMAC-SHA256 搜索索引；同上须互通
#   前端（dist）不持有任何密钥，仅转发 token。
# ============================================================

DB_USERNAME=lesson
DB_PASSWORD=强密码
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/lesson_appointment?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# ≥64 字符的随机串；若接续本地已有环境，直接粘贴本地现有值，不要重新生成
JWT_SECRET=与本地 application.properties 中一致的 Base64 串
# 32 字节随机数 Base64（44 字符带 =）；与 message.env 必须相同
CRYPTO_AESKEY=HVwcdqAh5A6nScL+0CRJYhKPLCI8y1FP9blj3BL9L4g=
# 32 字节随机数 Base64；与 message.env 必须相同
CRYPTO_HMACKEY=Ip0fg8W0iUXc9Iuw/rcsL+DQ3UkJklcATNqjAtwZmMA=

JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
