# ============================================================
# message-service（信息中心）环境变量模板
#
# ⚠️⚠️ 本文件是 **同步副本**，正本在 api/beforeRun/message.env.template
#      （deploy/upload-to-server.sh 与全部部署手册引用的都是正本）
#      改一处必须两处一起改 —— 守卫 check:secret-env 只校验正本，副本漂移不会报错。
#      历史上这里就是漂移过的：正本早已改成 AES_KEY，副本还留着 CRYPTO_AESKEY
#      （无效名，注入等于没注入，且不报错）。
#
# 用法：sudo cp message.env.template /etc/lesson/message.env
#       sudo chmod 600 /etc/lesson/message.env && sudo chown lesson:lesson /etc/lesson/message.env
# systemd 单元用 EnvironmentFile=/etc/lesson/message.env 注入
# ------------------------------------------------------------
# 密钥配对关系（务必与 booking.env / classroom.env 逐字符一致，否则 401 / 跨库解密失败）：
#   JWT_SECRET → jwt.secret      仅校验（api 签发），必须与 booking 相同
#   AES_KEY    → crypto.aes-key  与 booking 相同，方可互通解密 message_center 库字段
#   HMAC_KEY   → crypto.hmac-key 与 booking 相同
#   前端（dist）不持有任何密钥。
# ============================================================

DB_USERNAME=lesson
DB_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/message_center?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# 必须与 booking.env 的 JWT_SECRET 完全相同
JWT_SECRET=CHANGE_ME
# 必须与 booking.env 的 AES_KEY 完全相同
AES_KEY=CHANGE_ME
# 必须与 booking.env 的 HMAC_KEY 完全相同
HMAC_KEY=CHANGE_ME

JAVA_OPTS=-Xms128m -Xmx256m -Dfile.encoding=UTF-8

# 日志落盘位置。目录刻意用 message/ 而不是与 booking 同一个 api/，
# 否则两个服务的 spring-boot-app.log 会写进同一目录 —— 排查时根本分不清
# 哪一段堆栈属于谁。详见 booking.env.template 中 LOG_PATH 的完整说明
# 与 deploy/logrotate/lesson 的"两套滚动引擎不可交叉"说明。
LOG_PATH=/var/log/lesson/message

# 显式声明监听端口（与 jar 内 application.properties 的 server.port=8090 一致）。
# 作用：在个别环境若导出了 SERVER_PORT/SERVER__PORT 之类环境变量时，用本文件的值兜底，
# 确保 message-service 稳定监听 8090（而非被环境变量改成其他端口）。Spring 把 SERVER_PORT 映射为 server.port。
SERVER_PORT=8090
