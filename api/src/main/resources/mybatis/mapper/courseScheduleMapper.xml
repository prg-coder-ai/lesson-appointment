<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reservation.mapper.CourseScheduleMapper">
     
    <insert id="insertSchedule" parameterType="com.reservation.entity.CourseSchedule" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO course_schedule
        (schedule_id, name,course_id,  time_zone, start_time, end_time, repeat_type, repeat_interval, repeat_days, status, available_sites)
        VALUES
        (#{scheduleId}, #{name}, #{courseId} ,  #{timeZone}, #{startTime}, #{endTime}, #{repeatType}, #{repeatInterval}, #{repeatDays}, #{status}, #{availableSites})
    </insert> 
    <select id="selectByCreateDto" parameterType="com.reservation.dto.ScheduleCreateDTO" resultType="com.reservation.entity.CourseSchedule">
        SELECT *     FROM course_schedule         
        <where>
            <if test="scheduleId != null and scheduleId != ''">
                AND schedule_id = #{scheduleId}
            </if>
            <if test="courseId != null and courseId != ''">
                AND course_id = #{courseId}
            </if>
             
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            
            <if test="startTime != null">
                AND start_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND end_time &lt; #{endTime}
            </if>
            <if test="repeatType != null">
                AND repeat_type = #{repeatType}
            </if>
            <if test="repeatInterval != null">
                AND repeat_interval = #{repeatInterval}
            </if>
            <if test="repeatDays != null and repeatDays != ''">
                AND repeat_days = #{repeatDays}
            </if>
        </where>
    </select>
       
       
    <select id="selectListByPage" parameterType="com.reservation.query.ScheduleQueryPage" resultType="com.reservation.entity.CourseSchedule">
        SELECT * FROM course_schedule
        <where>
        TRUE
        <if test="scheduleName != null and scheduleName != ''">
            AND schedule_name LIKE CONCAT('%', #{scheduleName}, '%')
        </if>
        </where>
      <if test="pageSize != null and pageNum != null">
        LIMIT #{pageSize} OFFSET ${(pageNum - 1) * pageSize}
      </if>
    </select>

    <select id="selectCountByCondition" parameterType="com.reservation.query.ScheduleQueryPage" resultType="int">
        SELECT COUNT(*) FROM course_schedule
        <where>
        TRUE
        <if test="scheduleName != null and scheduleName != ''">
            AND schedule_name LIKE CONCAT('%', #{scheduleName}, '%')
        </if>
        </where>
    </select>
       
    <!-- 席位调整（增量）。业务侧已由 BookingSeatService.assertSitesNotBelowOccupied 校验
         「新容量不得低于已占位数」，这里再加一道纯 SQL 下界防线：
         available_sites 是 tinyint，允许负值，一旦被减到负数，该排期会永久拒绝新预定
         （闸门里 totalSites <= 0 直接抛异常），且已占位数恒大于容量 = 超卖。
         影响行数为 0 时调用方须视为失败。 -->
    <update id="updateSites" parameterType="com.reservation.dto.IncSiteBody">
        UPDATE course_schedule
        SET available_sites = available_sites + #{inc}
        WHERE schedule_id = #{scheduleId}
          AND available_sites + #{inc} >= 0
    </update>
    
     <update id="updateStatus" parameterType="com.reservation.dto.StatusBody">
        UPDATE course_schedule
        SET status = #{status}
        WHERE schedule_id= #{scheduleId}
    </update>

    <!-- update：与mybatis重复，此处无需定义 -->

    <select id="selectExceptionsByScheduleId" resultType="com.reservation.dto.ScheduleException">
        SELECT * FROM schedule_exception WHERE schedule_id = #{scheduleId}
    </select> 

<!-- INSERT_YOUR_CODE -->
<delete id="deleteByCourseId" parameterType="string">
    DELETE FROM course_schedule WHERE course_id = #{courseId}
</delete>

<!-- 原 selectActiveSchedulesByTeacherId（带租户条件）已删除：
     它唯一的调用方是免登录公开接口，拆分后即成死代码。
     现行实现见 CourseScheduleMapper#selectActiveSchedulesByTeacherIdIgnoreTenant（注解式，
     带 @InterceptorIgnore(tenantLine="true")）——不要在此处加回带租户条件的同名查询。 -->

<!-- 按ID加行锁读取排期（FOR UPDATE）。
     用途：把所有「占席位」的写路径（学生预定 / 改订 / 指定学生 / 候补递补）串行化到同一把排期行锁上。
     为什么必须加锁：名额校验读的是「其他行的聚合计数」，而随后的占位写入是本行——
     两者不在同一把锁下时，两个并发递补者会各自读到「还有空位」，各自 CAS 自己的记录成功，
     最终同一个排期出现两个 booked，超出总席位（各自的行锁互不冲突，拦不住）。 -->
<select id="selectByIdForUpdate" resultType="com.reservation.entity.CourseSchedule">
    SELECT * FROM course_schedule WHERE schedule_id = #{scheduleId} FOR UPDATE
</select>

</mapper>