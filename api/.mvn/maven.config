# 让「mvn」「spring-boot:run」在 Windows 上始终带上 UTF-8 参数
# 等价于每次在命令行传：mvn -Dargline=... -Dspring-boot.run.xxx=... ，但这里自动附加

# ----- Maven自身（surefire / 插件）用 UTF-8 -----
-DargLine=-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8

# ----- 若用户显式用 mvn.cmd 而非 bat，这里也可兜底（与 pom.xml properties 中一致） -----
-Dspring-boot.run.fork=true
-Dspring-boot.run.jvmArguments=-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005
