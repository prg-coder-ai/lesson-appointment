[Unit]
Description=Lesson Message Service
After=network.target
Wants=network.target
# 600 秒内最多自动重试 3 次，超过则放弃（服务进入 failed，不再自动拉起）
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# 建议用非 root 用户运行（按需创建：sudo useradd -r -s /bin/false lesson）
User=lesson
Group=lesson
WorkingDirectory=/opt/lesson
EnvironmentFile=/etc/lesson/message.env
# Java 路径按实际环境调整；可在此追加 JVM 参数，例如 -Xms256m -Xmx512m
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/lesson/message-service.jar
# 进程异常退出（非 0）时自动拉起；若要“任何退出都重启”改为 Restart=always
Restart=on-failure
# 每次重启前等待 10 秒，避免崩溃雪崩
RestartSec=10s
# ---- stdout/stderr 去向 ----
# ⚠️ 与 booking.service 同理：`append:` 是 systemd 240+ 语法，**只追加不滚动**。
# 滚动由 deploy/logrotate/lesson 统一接管，部署时必须装：
#   sudo cp deploy/logrotate/lesson /etc/logrotate.d/lesson
#
# message-service 的风险更高一级：它原先连 logback-spring.xml 都没有
# （2026-10-09 补上），即 systemd 那份是它**唯一**的日志去向 —— 之前没有任何备份计划。
StandardOutput=append:/var/log/lesson/message.log
StandardError=append:/var/log/lesson/message.log

[Install]
WantedBy=multi-user.target
