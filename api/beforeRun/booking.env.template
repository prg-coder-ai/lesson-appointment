# ============================================================
# booking（api 预约主系统）环境变量模板
# 用法：sudo cp booking.env.template /etc/lesson/booking.env
#       sudo chmod 600 /etc/lesson/booking.env && sudo chown lesson:lesson /etc/lesson/booking.env
# systemd 单元用 EnvironmentFile=/etc/lesson/booking.env 注入
# ------------------------------------------------------------
# 密钥配对关系（务必与 message.env 逐字符一致）：
#   JWT_SECRET     → jwt.secret      api 签发+校验；message-service 仅校验（共享密钥域）
#   AES_KEY  → crypto.aes-key  AES-256-GCM 字段加解密；两服务共用 message_center 库，须互通
#   HMAC_KEY → crypto.hmac-key HMAC-SHA256 搜索索引；同上须互通
#   WECHAT_APPID  → wechat.miniapp.appid  小程序 appid（非密钥，但同样走 env 免改包重启）
#   WECHAT_SECRET → wechat.miniapp.secret  小程序 appsecret
#   前端（dist）不持有任何密钥，仅转发 token。
# ============================================================

DB_USERNAME=lesson
DB_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/lesson_appointment?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# ≥64 字符的随机串；若接续本地已有环境，直接粘贴本地现有值，不要重新生成
JWT_SECRET=CHANGE_ME
# 32 字节随机数 Base64（44 字符带 =）；与 message.env 必须相同
AES_KEY=CHANGE_ME
# 32 字节随机数 Base64；与 message.env 必须相同
HMAC_KEY=CHANGE_ME

JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8

# ------------------------------------------------------------
# 日志落盘位置（2026-10-09 补，此前模板里没有这一项）
#
# 不设时的后果：logback-spring.xml 里的 ${LOG_PATH:-./logs} 会退化成相对路径 ./logs，
# WorkingDirectory=/opt/lesson → 实际落在 **/opt/lesson/logs/**，而不是运维约定的
# /var/log/lesson/。于是系统里出现两份日志、两种命运：
#   /opt/lesson/logs/spring-boot-app.log   logback 管，有 50MB/30天/5GB 三重滚动 ✅
#   /var/log/lesson/booking.log            systemd append: 管，**永不滚动** ❌
# 后者把磁盘写满会拖垮全站，而 tail -f /var/log/lesson/*.log 恰恰是排障第一反应，
# 运维看到"日志在 /var/log/lesson"就不会想到去 /opt/lesson/logs 找另一份。
#
# 目录与message-service 刻意错开（api/ 与 message/），原因见 deploy/logrotate/lesson：
# logrotate 只管 /var/log/lesson/*.log，logback 只管 ${LOG_PATH}/**，
# 两套引擎若管同一个文件会互相踩（fd 指向已重命名的 inode，"当前文件"永远为空）。
# 首次部署需：sudo mkdir -p /var/log/lesson/api && sudo chown -R lesson:lesson /var/log/lesson
# ------------------------------------------------------------
LOG_PATH=/var/log/lesson/api

# 小程序凭据（2026-10-14：微信登录/绑定一期已上线，占位时服务启动 WARN 且接口静默降级 1001）
WECHAT_APPID=CHANGE_ME
WECHAT_SECRET=CHANGE_ME

# 微信开放平台·网站应用凭据（2026-10-14 P2 PC 扫码登录；未建网站应用前保持 CHANGE_ME，
# 扫码回调会降级提示"授权失败"，不影响小程序链路）
WECHAT_OPEN_APPID=CHANGE_ME
WECHAT_OPEN_SECRET=CHANGE_ME
# 授权回调完整 URL：须与开放平台网站应用里配置的授权回调域一致（生产必须是 HTTPS 备案域名）
WECHAT_OPEN_REDIRECT_URI=http://localhost:8080/api/v1/auth/wechat/pc-callback
