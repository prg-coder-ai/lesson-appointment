# ============================================================
# classroom-service（在线课堂）环境变量模板
# 用法：sudo cp classroom.env.template /etc/lesson/classroom.env
#       sudo chmod 600 /etc/lesson/classroom.env && sudo chown lesson:lesson /etc/lesson/classroom.env
# systemd 单元用 EnvironmentFile=/etc/lesson/classroom.env 注入（见 api/beforeRun/classroom.service）
# ------------------------------------------------------------
# 密钥配对关系（务必与 booking.env / message.env 逐字符一致）：
#   JWT_SECRET → jwt.secret      仅校验（api 签发）。课堂的 WebSocket 握手
#                                （WsHandshakeAuthInterceptor）也用这把密钥验 token —— 不一致直接 401，
#                                表现为「课堂页打不开 / 白板与心跳连不上」。
#   AES_KEY    → crypto.aes-key  AES-256-GCM 字段加解密；三服务须互通
#   HMAC_KEY   → crypto.hmac-key HMAC-SHA256 搜索索引；同上须互通
#   前端（dist）不持有任何密钥。
#
# ⚠️ 变量名必须逐字为 AES_KEY / HMAC_KEY。写成 CRYPTO_AESKEY 不会报错，
#   只会静默回落 properties 里的内置默认值（= 仓库里公开的那串）。
#   机理与对照实验见 tools/check-secret-env-guard.mjs 头部注释。
# ============================================================

DB_USERNAME=lesson
DB_PASSWORD=CHANGE_ME
# 课堂用**自己的库** classroom（与主库 lesson_appointment 同一个 MySQL 实例，
# 因为还要跨库只读 sys_tenant_eclassroom 判断租户是否开通课堂）。
# createDatabaseIfNotExist=true 只建"库"，不会建表 —— 表必须导 classroom-schema.sql。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/classroom?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# 必须与 booking.env 的 JWT_SECRET 完全相同
JWT_SECRET=CHANGE_ME
# 必须与 booking.env 的 AES_KEY 完全相同
AES_KEY=CHANGE_ME
# 必须与 booking.env 的 HMAC_KEY 完全相同
HMAC_KEY=CHANGE_ME

# ===== Redis（课堂独有依赖，用 db 2）=====
# 在线状态判定的**唯一真相源**（掉线扫描器只看 Redis key 在不在，DB 的 online_state 只是展示态）
# + 用户维度限流计数（进课堂/建上传/发点名/交作业）。
# 没装 Redis 也能启动（限流降级为进程内、掉线判定失准），但多实例部署时在线状态会错乱。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 源码里没有 password 这一项 —— 设了 requirepass 才用下面这行，靠 Spring 宽松绑定注入
# （SPRING_DATA_REDIS_PASSWORD → spring.data.redis.password，RedisProperties 是 @ConfigurationProperties）
# SPRING_DATA_REDIS_PASSWORD=CHANGE_ME

# ===== 回调预约系统的地址 =====
# 同机部署就是本机 8081；不要填公网域名，否则回调绕出去一圈还可能被安全组拦掉。
BOOKING_API_URL=http://127.0.0.1:8081

# ===== 对象存储（讲稿 / 作品 / 录制）=====
# local = 本机磁盘（内置、真实可用）；s3 / oss 需先实现 ObjectStorage 接口。
# ⚠️ DB 里只存对象 key，真实字节在这个目录 —— **备份必须库 + 目录一起做**，
#    只回库不回文件 = 记录都在、点开全 404。
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/opt/lesson/data/oss
# 对外访问前缀；留空则输出相对路径 /api/v1/files/...（走同源反代，推荐留空）
# STORAGE_PUBLIC_BASE_URL=

# ===== RTC 媒体选型 =====
# native-mesh（默认，浏览器两两直连，零外部依赖，≤6 人）| livekit | trtc | agora
# 任何 provider 缺凭据/缺依赖都会启动时**自动降级 native-mesh** 并打 WARN，
# 用 GET /api/v1/rtc/providers 看 configured / active / degraded。
RTC_PROVIDER=native-mesh
# 生产强烈建议配 TURN：只有 STUN 时，对称型 NAT / 企业防火墙下约 2~3 成用户建连失败。
# coturn 的 static-auth-secret 走 REST 临时凭证，不用固定账号密码。
# RTC_TURN_URLS=turn:turn.example.com:3478?transport=udp
# RTC_TURN_SECRET=CHANGE_ME
# 学生默认不推视频（省上行）；学生音频始终可发，出声与否由服务端禁言态强控
# RTC_STUDENT_VIDEO=false

JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8

# 日志落盘位置。三个服务各用一个子目录，否则 logback 会写进同一目录、
# 排障时分不清堆栈属于谁。详见 booking.env.template 的 LOG_PATH 说明与
# deploy/logrotate/lesson 里"两套滚动引擎不可交叉"的说明。
LOG_PATH=/var/log/lesson/classroom

# 显式声明监听端口（与 jar 内 application.properties 的 server.port=8092 一致）。
# 作用：个别环境若导出了 SERVER_PORT/SERVER__PORT 之类变量，用本文件的值兜底。
# Spring 把 SERVER_PORT 映射为 server.port。
SERVER_PORT=8092
