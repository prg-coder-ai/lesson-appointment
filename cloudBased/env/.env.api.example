# ==============================================================================
# 微信云托管 · api 服务环境变量模板
# 对应手册 6.2 节变量清单 + 6.3 节已知修正
#
# 使用方式：
#   1. 复制本文件到一份 .env（不要提交到 Git）
#   2. 把值替换为真实值
#   3. 登录微信云托管控制台 → api 服务 → 服务设置 → 环境变量
#   4. 把下表变量**按原名**填入；带 ⚠️ 的用「加密变量」
#   5. 改完后**必须重新发布版本**才生效
#
# 占位符说明：
#   ${MYSQL_HOST}      — 云托管内建 MySQL 填 MYSQL_ADDRESS 的主机部分（去掉端口）
#   ${MYSQL_PORT}      — 云托管内建 MySQL 填 MYSQL_ADDRESS 的端口部分（通常 3306）
#   ${MYSQL_DB}        — 填 lesson_appointment
#   ${变量名} 这种格式是 Properties 的默认值 fallback，环境变量注入后会直接覆盖
#
# 时区三处统一：容器 TZ、serverTimezone、数据库时区 —— 全部 Asia/Shanghai
# ==============================================================================

# ---------- 数据库（手册 4.3 接法 1：直接用本项目 Properties 读取的变量名） ----------
# 接法 1：按 Properties 原名填（零代码改动，推荐）
DB_USERNAME=REPLACE_WITH_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD_ENCRYPTED
SPRING_DATASOURCE_URL=jdbc:mysql://REPLACE_WITH_DB_HOST:REPLACE_WITH_DB_PORT/lesson_appointment?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# 接法 2（手册 4.3）：用云托管内建的 MYSQL_* 变量名 —— 取消注释、注释掉上面接法 1 即可
# MYSQL_ADDRESS=REPLACE_WITH_CLOUD_MYSQL_ADDRESS
# MYSQL_USERNAME=REPLACE_WITH_CLOUD_MYSQL_USERNAME
# MYSQL_PASSWORD=REPLACE_WITH_CLOUD_MYSQL_PASSWORD
# SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_ADDRESS}/lesson_appointment?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# ---------- 密钥（手册 6.2 标记 ⚠️ 的一律走加密变量） ----------
# JWT_SECRET：api 与 message-service 必须**逐字符一致**（共享密钥域）
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# AES_KEY / HMAC_KEY：手册 6.3 已对齐为正确变量名（不是 CRYPTO_AESKEY/CRYPTO_HMACKEY）
# 格式：Base64 编码的 32 字节密钥（AES-256 + HMAC-SHA256）
# api 与 message-service 必须**逐字符一致**
AES_KEY=REPLACE_WITH_BASE64_32BYTES_AES_KEY
HMAC_KEY=REPLACE_WITH_BASE64_32BYTES_HMAC_KEY

# ---------- 微信小程序 ----------
WECHAT_APPID=REPLACE_WITH_MINIAPP_APPID
WECHAT_SECRET=REPLACE_WITH_MINIAPP_SECRET_ENCRYPTED

# ---------- 微信开放平台（PC 网站扫码） ----------
WECHAT_OPEN_APPID=REPLACE_WITH_WECHAT_OPEN_APPID
WECHAT_OPEN_SECRET=REPLACE_WITH_WECHAT_OPEN_SECRET_ENCRYPTED
WECHAT_OPEN_REDIRECT_URI=REPLACE_WITH_AUTH_CALLBACK_DOMAIN_ONLY_NO_PATH

# ---------- 时区（手册 4.2 强制项，必须 Asia/Shanghai） ----------
TZ=Asia/Shanghai
