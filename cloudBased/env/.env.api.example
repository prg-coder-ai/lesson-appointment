# ==============================================================================
# 微信云托管 · api 服务环境变量模板
# 对应手册 6.2 节变量清单 + 6.3 节已知修正
#
# 使用方式：
#   1. 复制本文件到一份 .env（不要提交到 Git）
#   2. 把值替换为真实值
#   3. 登录微信云托管控制台 → api 服务 → 服务设置 → 环境变量
#   4. 把下表变量**按原名**填入；带 ⚠️ 的用「加密变量」
#   5. 改完后**必须重新发布版本**才生效
#
# 时区三处统一：容器 TZ、serverTimezone、数据库时区 —— 全部 Asia/Shanghai
#
# 所有密钥示例值均为随机生成，仅作格式参考，上线前务必替换为自己生成的真实密钥。
# 生成方式：node -e "require('crypto').randomBytes(32).toString('base64')"
# ==============================================================================

# ---------- 数据库（手册 4.3 接法 1：直接用本项目 Properties 读取的变量名） ----------
# 格式：普通字符串；云托管场景通常填新建数据库时设定的账号
DB_USERNAME=lesson

# 格式：普通字符串；建议 12~20 位，含大小写+数字+符号
# ⚠️ 密钥类，云托管控制台走「加密变量」
DB_PASSWORD=txlessontx@dB

# 格式：标准 JDBC URL；把 host / port 换成数据库实例地址和端口
# 库名固定 lesson_appointment（api 业务库）
# 云托管内建 MySQL：host 通常取 MYSQL_ADDRESS 的主机部分，port 通常 3306
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_ADDRESS}/lesson_appointment?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# 接法 2（手册 4.3）：用云托管内建的 MYSQL_* 变量名 —— 取消注释、注释掉上面接法 1 即可
# MYSQL_ADDRESS=10.0.0.15:3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=L3sson@2026
# SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_ADDRESS}/lesson_appointment?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# ---------- 密钥（手册 6.2 标记 ⚠️ 的一律走加密变量） ----------

# JWT_SECRET：HS512 签名密钥，UTF-8 编码后**至少 64 字节**（后端 JwtUtil.java L44-46 校验）
# 格式：纯字符串（不是 Base64），建议 64~128 字符的随机混合串
# api 与 message-service 必须**逐字符一致**（共享密钥域）
# 生成：node -e "require('crypto').randomBytes(48).toString('base64')"
# ⚠️ 密钥类，云托管控制台走「加密变量」
JWT_SECRET=YWhNkbPEpaJxWvFFfxMC5J0dYNF+C3VvWa1IZlZtPixZ2jIEMI7YKI1six98kmMB.24679cd797915eb027f818ee0efc8b3131f7686d106a81d8

# AES_KEY：AES-256-GCM 字段加密密钥
# 格式：Base64 字符串，**解码后必须精确 32 字节**（后端 CryptoUtil.java L44-46 校验）
# 生成：node -e "require('crypto').randomBytes(32).toString('base64')"
# api 与 message-service 必须**逐字符一致**
# ⚠️ 密钥类，云托管控制台走「加密变量」
AES_KEY=dHfyfh1Wpg7aCBF8MmpYtATTOTJjOdLy167GDwy39WI=

# HMAC_KEY：HMAC-SHA256 搜索索引密钥
# 格式：Base64 字符串，**解码后建议 32 字节**（与 SHA-256 输出长度匹配）
# 生成：node -e "require('crypto').randomBytes(32).toString('base64')"
# api 与 message-service 必须**逐字符一致**
# ⚠️ 密钥类，云托管控制台走「加密变量」
HMAC_KEY=hb8WyEJ/w2hed9YuJqbtb07JJel/ar3IA69FwvrmScE=

# ---------- 微信小程序 ----------
# 格式：微信公众平台 → 小程序管理 → 开发设置 → AppID，通常 18 位数字
WECHAT_APPID=wxabc123def456ghi789

# 格式：微信公众平台 → 小程序管理 → 开发设置 → AppSecret，32 位小写十六进制
# ⚠️ 密钥类，云托管控制台走「加密变量」
WECHAT_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d

# ---------- 微信开放平台（PC 网站扫码） ----------
# 格式：开放平台网站应用的 AppID，通常以 wxd 开头的 18 位字符串
WECHAT_OPEN_APPID=wxd1234567890abcdef

# 格式：开放平台网站应用的 AppSecret，32 位小写十六进制
# ⚠️ 密钥类，云托管控制台走「加密变量」
WECHAT_OPEN_SECRET=2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e

# 格式：授权回调域名（只填域名，不要带 https://、不要带路径）
# 必须与开放平台网站应用设置里的「授权回调域」完全一致
WECHAT_OPEN_REDIRECT_URI=auth.example.com

# ---------- 时区（手册 4.2 强制项，必须 Asia/Shanghai） ----------
TZ=Asia/Shanghai


