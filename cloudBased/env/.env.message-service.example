# ==============================================================================
# 微信云托管 · message-service 环境变量模板
# 与 api 共享 JWT_SECRET / AES_KEY / HMAC_KEY —— 必须逐字符一致！
# 不含微信相关变量（message-service 不直接调微信 API）
# ==============================================================================

# ---------- 数据库 ----------
# 库名：message_center
DB_USERNAME=REPLACE_WITH_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD_ENCRYPTED
SPRING_DATASOURCE_URL=jdbc:mysql://REPLACE_WITH_DB_HOST:REPLACE_WITH_DB_PORT/message_center?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# ---------- 密钥（必须与 api 完全相同！） ----------
JWT_SECRET=REPLACE_WITH_SAME_AS_API_JWT_SECRET
AES_KEY=REPLACE_WITH_SAME_AS_API_AES_KEY_BASE64
HMAC_KEY=REPLACE_WITH_SAME_AS_API_HMAC_KEY_BASE64

# ---------- 时区 ----------
TZ=Asia/Shanghai
