# ==============================================================================
# 微信云托管 · message-service 环境变量模板
# 与 api 共享 JWT_SECRET / AES_KEY / HMAC_KEY —— 必须逐字符一致！
# 不含微信相关变量（message-service 不直接调微信 API）
#
# 所有密钥示例值与 api 文件完全相同，上线时复制同一组值到两个服务即可。
# ==============================================================================

# ---------- 数据库 ----------
# 库名固定：message_center
# 格式：普通字符串；云托管场景与 api 共用同一数据库实例的不同库
DB_USERNAME=lesson

# 格式：普通字符串；建议 12~20 位，含大小写+数字+符号
# ⚠️ 密钥类，云托管控制台走「加密变量」
DB_PASSWORD=txlessontx@dB

# 格式：标准 JDBC URL；host / port 与 api 的 SPRING_DATASOURCE_URL 保持一致
# 库名固定 message_center（消息中心库）；首次连接自动建库
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_ADDRESS}/message_center?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true   

# ---------- 密钥（必须与 api 完全相同！逐字符复制！） ----------

# JWT_SECRET：HS512 签名密钥，UTF-8 ≥ 64 字节
# ⚠️ 必须与 api 的 JWT_SECRET 逐字符一致，否则跨服务鉴权会失败
# ⚠️ 密钥类，云托管控制台走「加密变量」
JWT_SECRET=YWhNkbPEpaJxWvFFfxMC5J0dYNF+C3VvWa1IZlZtPixZ2jIEMI7YKI1six98kmMB.24679cd797915eb027f818ee0efc8b3131f7686d106a81d8

# AES_KEY：Base64 字符串，解码后精确 32 字节（AES-256）
# ⚠️ 必须与 api 的 AES_KEY 逐字符一致
# ⚠️ 密钥类，云托管控制台走「加密变量」
AES_KEY=dHfyfh1Wpg7aCBF8MmpYtATTOTJjOdLy167GDwy39WI=

# HMAC_KEY：Base64 字符串，解码后建议 32 字节（HMAC-SHA256）
# ⚠️ 必须与 api 的 HMAC_KEY 逐字符一致
# ⚠️ 密钥类，云托管控制台走「加密变量」
HMAC_KEY=hb8WyEJ/w2hed9YuJqbtb07JJel/ar3IA69FwvrmScE=

# ---------- 时区 ----------
TZ=Asia/Shanghai
