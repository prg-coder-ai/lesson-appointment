# ==============================================================================
# Nginx 反代配置模板（前端静态 + 双后端反代）
#
# ★ 2026-10-25 修订：后端已拆成**两个独立云托管实例**，本模板从「单上游」改为「双上游」
#    ① booking-api      容器端口 8081
#    ② message-service  容器端口 8090
#
# ★ 2026-10-29 等保 P0-2/P0-3：新增 6 大安全响应头 + HSTS + 接口限流 zone
#
# 两个占位符由 /docker-entrypoint.d/00-resolver.sh 在**容器启动时**用 envsubst 白名单渲染，
# 值来自**运行时环境变量**（云托管控制台 → 服务设置 → 环境变量）：
#
#   API_UPSTREAM  = http://api-xxxxxxxx.ap-shanghai.internal-run.tcloudbase.com:8081
#   MSG_UPSTREAM  = http://message-service-xxxxxxxx.ap-shanghai.internal-run.tcloudbase.com:8090
#
#   · 内网域名从控制台「服务设置 → 内网访问」复制（开启内网访问会触发一次发布才分配），
#     必须带端口，端口只能等于该服务发布时填的容器端口（8081 / 8090），内网是 http。
#   · 公网兜底则相反：https + 不带端口，如
#       https://api-329614-8-1475810246.sh.run.tcloudbase.com
#       https://message-service-329614-8-1475810246.sh.run.tcloudbase.com
#     注意是 message-**service**，不是 message-（后者 INVALID_HOST 404）。
#   · 变量缺失或不合格 → 容器**启动即失败**并打印中文原因，不会出现 Running 但全 502。
#
# ❌❌ 绝对不要用 api.<环境ID>.svc.cluster.local / message-service.<环境ID>.svc.cluster.local
#   2026-11-08 在云托管实例 WebShell 内实测（证据留在 .workbuddy/memory/2026-11-08.md）：
#     · nslookup api.<envid>.svc.cluster.local  → NXDOMAIN
#     · nslookup api（同命名空间短名）           → NXDOMAIN
#     · /etc/resolv.conf 只有 nameserver 127.0.0.1（平台本地 stub，不做服务发现）
#   微信云托管**没有**这套 K8s Service 记录，写它必然全站接口 502（静态页正常，极难查）。
#
# ⚠ 为什么 Host 头不再写 $host：
#   公网域名场景下上游是云托管，它靠 Host/SNI 路由。$host 是**前端自己的域名**，
#   发过去会被判成 INVALID_HOST 或落到别的服务上（表现为 404 而非连接失败，
#   比连不上更难查）。这里**故意不写** proxy_set_header Host —— 由 nginx 自动用
#   proxy_pass 里的主机名（$proxy_host）作为 Host 与 SNI，天然正确。
#
# ⚠ 为什么不用 upstream 块做 keepalive：
#   占位符里带协议（http:// 或 https://），upstream 的 server 指令不接受。
#   要用 keepalive 就得再拆出"只含 host:port"的变量。内网地址下每请求新建 TCP
#   的代价可以接受，先不引入这套复杂度；确实需要时另说。
# ==============================================================================

# ═══════════════════════════════════════════════════════
# 等保 P0-3：接口限流 zone 定义
# key=客户端 IP；rate=每秒请求数；burst=允许的突发队列（超过 rate 的排队，超 burst 直接 429）
# ═══════════════════════════════════════════════════════
limit_req_zone $binary_remote_addr zone=login_zone:10m   rate=5r/s;
limit_req_zone $binary_remote_addr zone=sms_zone:10m     rate=1r/m;
limit_req_zone $binary_remote_addr zone=public_zone:10m  rate=50r/s;
limit_req_zone $binary_remote_addr zone=api_zone:20m    rate=100r/s;

server {
    listen       8080;
    server_name  _;

    # ═══════════════════════════════════════════════════════
    # 上游地址：由 00-resolver.sh 在容器启动时用环境变量渲染（运行时，不是构建期）。
    # 使用 nginx 变量 + proxy_pass $var，让域名解析推迟到**请求期**，
    # 避免 nginx 启动时因后端 DNS 不可达而 crash-loop（换域名也不必重建镜像）。
    #
    # ⚠ 代价（必须知道）：nginx 里**只要 proxy_pass 用了变量，就必须有 resolver 指令**，
    #   否则每个请求都 502 且 error_log 报 "no resolver defined to resolve xxx"。
    #   本文件的 resolver 不在自身，由同一个 00-resolver.sh 从 /etc/resolv.conf 写入
    #   /etc/nginx/conf.d/00-resolver.conf —— 该脚本取不到 nameserver 就 exit 1，
    #   宁可容器起不来（日志可见），也不再出现「Running 但接口全 502」。
    # ═══════════════════════════════════════════════════════
    set $api_upstream "${API_UPSTREAM}";
    set $msg_upstream "${MSG_UPSTREAM}";

    root   /var/www/frontend;             # dist 已复制到容器 /var/www/frontend
    index  index.html;                    # dist/index.html = 统一登录入口页

    charset utf-8;
    client_max_body_size 20m;
    server_tokens off;

    # ═══════════════════════════════════════════════════════
    # 等保 P0-2：6 大安全响应头 + HSTS（对所有 location 生效）
    # ═══════════════════════════════════════════════════════
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # ---------- 通用代理参数（对所有后端起效）----------
    proxy_http_version 1.1;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host  $host;

    # ★★ 必须删掉 Origin 头，否则登录等 POST 接口一律 403「Invalid CORS request」（2026-11-08 实测）
    #
    # 成因（三层叠加，缺一不报）：
    #   ① 浏览器对**同源 POST** 也会自带 Origin: https://<前端域名>（这是规范行为，不是前端写错）；
    #   ② 本模板故意不透传 Host（上游是云托管域名，靠 Host/SNI 路由，传前端 $host 会
    #      INVALID_HOST / 落错服务），于是后端看到的 Host 是 <api域名>；
    #   ③ Spring 的 CorsUtils.isCorsRequest() 拿 Origin 与 request.getServerName()（= Host）比，
    #      两者域名不同 → 判为**跨域** → DefaultCorsProcessor 发现白名单里没这个源 →
    #      返回 403 + 纯文本 "Invalid CORS request"。
    #      而 application-cloud.properties 的 app.cors.allowed-origin-patterns 默认是**空**，
    #      所以云端必然拒绝。
    #
    # 为什么删头而不是改 Host：删头后 CorsUtils 看不到 Origin → 判定"非跨域" → 直接进业务，
    # 语义上也正确（浏览器↔nginx 本来就是同源，是 nginx→上游这一跳把 Host 换了）。
    # 为什么优于"给后端配 CORS 白名单"：不用改 jar、不用重启 api 服务。
    #
    # ⚠ 前提：前端**同源反代**部署（默认）。若哪天改成前端直连后端公网域名（真跨域），
    #   这行会让预检/跨域失效 —— 那时应删掉本行，改为在后端配 APP_CORS_ORIGIN_PATTERNS。
    proxy_set_header   Origin            "";

    # 上游是 https 时才生效（公网域名场景）。指向 http 内网地址时这几行是空操作。
    proxy_ssl_server_name on;
    proxy_ssl_protocols   TLSv1.2 TLSv1.3;

    proxy_connect_timeout 10s;
    proxy_read_timeout    120s;
    proxy_send_timeout    120s;

    # ==========================================================================
    # 一、走 message-service 的 4 条（前缀必须与 dev-proxy.js 完全一致）
    #   /api/v1/message*   → messages / message-templates / message-categories（复数）
    #   /api/v1/sensitive* → 敏感词
    #   /api/v1/sse*       → SSE 实时推送
    #   /api/v1/users/*    → 收件箱台账（★ 复数；业务后台是单数 /api/v1/user/*）
    # ==========================================================================

    # SSE：三条必配（buffer off / cache off / 长超时）。少一条 → 连接建立但收不到消息，
    # 前端 EventSource 每秒重连一次。原有 120s 的 read_timeout 会每 2 分钟掐断一次。
    location /api/v1/sse {
        proxy_pass $msg_upstream;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection '';   # 不发送 Connection: close
        chunked_transfer_encoding on;

        # 云托管私有协议网关的小程序 Header 透传（小程序端 SSE 也走这里）
        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;

        limit_req zone=api_zone burst=50 nodelay;
        limit_req_status 429;
    }

    location /api/v1/message {
        proxy_pass $msg_upstream;
        proxy_set_header Connection '';
        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;
        limit_req zone=api_zone burst=50 nodelay;
        limit_req_status 429;
    }

    location /api/v1/sensitive {
        proxy_pass $msg_upstream;
        proxy_set_header Connection '';
        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;
        limit_req zone=api_zone burst=50 nodelay;
        limit_req_status 429;
    }

    location /api/v1/users/ {
        proxy_pass $msg_upstream;
        proxy_set_header Connection '';
        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;
        limit_req zone=api_zone burst=50 nodelay;
        limit_req_status 429;
    }

    # ==========================================================================
    # 二、走 booking 的其余 /api/v1/*
    # ⚠ proxy_pass 后面**不能带 URI**（不能写成 $api_upstream/api/），
    #   否则 /api/v1/ 前缀会被替换掉，后端全部 404。
    # ==========================================================================

    # 🔐 登录/注册 —— 5 r/s（防暴力破解）
    location ~* ^/api/v1/(auth/login|auth/refreshToken|auth/logout|auth/wechat-login|auth/wechat-register|auth/wechat/qr|auth/wechat/pc-callback|user/register|promo/register-tenant|promo/register-user|promo/referral/validate)$ {
        proxy_pass $api_upstream;
        limit_req zone=login_zone burst=10 nodelay;
        limit_req_status 429;
        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;
    }

    # 📖 公开 GET 接口 —— 50 r/s（teacherPublishedProfile / 小程序入口页）
    location ~* ^/api/v1/(teacher/published|course/public|tenant/public|industry/options|apiInfo|system/info|tenant/name|legal/doc|term/map|interfaces) {
        proxy_pass $api_upstream;
        limit_req zone=public_zone burst=30 nodelay;
        limit_req_status 429;
        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;
    }

    # 🔒 其余 /api/v1/ —— 100 r/s（正常业务）
    location /api/v1/ {
        proxy_pass $api_upstream;
        proxy_set_header Connection '';
        proxy_cache off;                  # 登录/注册有频率闸，响应一律不缓存

        proxy_set_header X-WX-OPENID  $http_x_wx_openid;
        proxy_set_header X-WX-UNIONID $http_x_wx_unionid;
        proxy_set_header X-WX-APPID   $http_x_wx_appid;
        proxy_set_header X-WX-ENV     $http_x_wx_env;

        limit_req zone=api_zone burst=50 nodelay;
        limit_req_status 429;
    }

    # ---------- /actuator 只暴露 health,info（booking）----------
    # health 匿名放行（Nginx 探活用）；info/env/beans 等由 Spring Security httpBasic 保护，
    # 此处 Nginx 直接反代即可。
    location /actuator/ {
        proxy_pass $api_upstream;
        access_log off;
        limit_req zone=public_zone burst=10 nodelay;
        limit_req_status 429;
    }

    # ---------- 消息服务探活（对应 message-service 白名单 /api/v1/system/info）----------
    location = /msg-health {
        proxy_pass $msg_upstream/api/v1/system/info;
        access_log off;
    }

    # ---------- 静态资源缓存 ----------
    # ⚠ nginx 的 add_header 是**覆盖式继承**：只要 location 里出现任意一条 add_header，
    #   上面 server 级那 6 条安全响应头就全部**不再下发**到这个 location 的响应上。
    #   所以下面这几处缓存控制一律改用 expires（它不参与 add_header 继承），
    #   安全头才能真正出现在**每一个**响应里（html/js/css 恰恰是审计最常查的）。
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|otf|mp4|webp)$ {
        expires 7d;                       # → Cache-Control: max-age=604800
        try_files $uri =404;
    }

    # ---------- HTML 与构建信息：每次回源校验 ----------
    # 本项目是**多页应用**（login/admin/teacher/student/platform_admin…），不做 SPA 的
    # index.html 回退：路径不对就该 404，否则错链会被"静默"成首页，排查时极难发现。
    location / {
        try_files $uri $uri/ =404;
    }

    # expires -1 → Cache-Control: no-cache（强制回源校验），且不影响安全头下发
    location ~* \.html$ {
        expires -1;
    }

    location = /build-info.json {
        expires -1;
    }

    # ---------- 小程序远程配置 ----------
    # 小程序 onLaunch 时拉取本文件获取上游地址（免重新发版）。
    # 必须每次回源校验（expires -1），否则改了配置小程序拿到的还是旧值。
    location = /app-config.json {
        expires -1;
    }

    # ---------- Gzip ----------
    # 不要压缩 text/event-stream（会引入缓冲，SSE 立刻变"卡"）
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_vary on;
}
