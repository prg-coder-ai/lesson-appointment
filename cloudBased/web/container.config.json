{
  "_comment": "web 服务 container.config.json —— 前端静态托管 + /api 反代",
  "containerPort": 80,
  "dockerfilePath": "Dockerfile",
  "buildDir": "",
  "minNum": 0,
  "maxNum": 10,
  "cpu": 0.25,
  "mem": 0.5,
