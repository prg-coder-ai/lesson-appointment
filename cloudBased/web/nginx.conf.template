# ==============================================================================
# Nginx 反代配置模板（前端静态 + /api 反代）
# 使用 envsubst 替换 ${API_UPSTREAM} / ${CLASSROOM_UPSTREAM}，部署前执行：
#
#   export API_UPSTREAM=http://api.<envid>.svc.cluster.local:8081
#   export CLASSROOM_UPSTREAM=http://classroom.<envid>.svc.cluster.local:8092
#   # 或公网地址：export API_UPSTREAM=https://api-<envid>.sh.run.tcloudbase.com
#   envsubst '$API_UPSTREAM $CLASSROOM_UPSTREAM' < nginx.conf.template > nginx.conf
#
# 然后再 docker build（或让 Dockerfile 里的 RUN 步骤自动做）
# ==============================================================================

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # ---------- 静态资源缓存 ----------
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|otf|mp4|webp)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---------- 在线课堂 classroom-service 反代 ----------
    # 必须在通用 /api/ 之前（含更长的前缀由 nginx 最长匹配优先，位置顺序仅为可读）
    location /api/v1/classrooms/ {
        proxy_pass         ${CLASSROOM_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /api/v1/recordings/ {
        proxy_pass         ${CLASSROOM_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
    location /api/v1/admin/classrooms/ {
        proxy_pass         ${CLASSROOM_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
    # 课堂 WebSocket：白板/心跳/信令三通道，需 Upgrade 头 + 长连接
    location /ws/classrooms/ {
        proxy_pass         ${CLASSROOM_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---------- SPA fallback：除了 /api 和静态资源，全部回 index.html ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- /api 反代到后端 ----------
    # ${API_UPSTREAM} 由 envsubst 填充
    location /api/ {
        proxy_pass         ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;

        # 关键：云托管私有协议网关的小程序 Header 透传
        proxy_set_header   X-WX-OPENID    $http_x_wx_openid;
        proxy_set_header   X-WX-UNIONID    $http_x_wx_unionid;
        proxy_set_header   X-WX-APPID      $http_x_wx_appid;
        proxy_set_header   X-WX-ENV        $http_x_wx_env;

        # 超时
        proxy_connect_timeout 10s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
    }

    # ---------- /actuator 只暴露 health,info ----------
    location /actuator/ {
        proxy_pass              ${API_UPSTREAM}/actuator/;
        proxy_http_version      1.1;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
    }

    # ---------- Gzip ----------
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 6;
}
