>>>>>>> local
  </div>

  <main class="legal-main">
    <h1 class="doc-title" id="doc-title" style="display:none;"></h1>
    <div class="doc-meta" id="doc-meta" style="display:none;"></div>
    <div class="doc-content" id="doc-content"></div>
    <div class="legal-state" id="state">加载中…</div>
  </main>

  <div class="legal-footer" id="footer">本页面内容由平台或您所属机构发布，仅供参考。如与正式签署文本不一致，以平台留存版本为准。</div>

  <script>
    (function () {
      var PARAMS = new URLSearchParams(location.search);
      var type = PARAMS.get('type') || 'user_agreement';
      var lang = 'zh'; // 暂不提供语言切换，强制默认中文
      var tenant = PARAMS.get('tenant') || '';
      // 统一 API 前缀：裸路径 + 前缀拼接，避免散落硬编码完整 /api/v1 端点（守卫约定）
      var API_BASE = '/api/v1';

      var TYPES = { user_agreement: '用户协议', privacy_policy: '隐私政策' };
      var LANGS = { zh: '中文', en: 'English', fr: 'Français' };

      var stateEl = document.getElementById('state');
      var titleEl = document.getElementById('doc-title');
      var metaEl = document.getElementById('doc-meta');
      var contentEl = document.getElementById('doc-content');

      function syncSeg() {
        document.querySelectorAll('#type-seg button').forEach(function (b) {
          b.className = (b.getAttribute('data-type') === type) ? 'active' : '';
        });
        document.querySelectorAll('#lang-seg button').forEach(function (b) {
          b.className = (b.getAttribute('data-lang') === lang) ? 'active' : '';
        });
      }

      function showState(msg, isError) {
        stateEl.textContent = msg;
        stateEl.className = 'legal-state' + (isError ? ' error' : '');
        stateEl.style.display = 'block';
        titleEl.style.display = 'none';
        metaEl.style.display = 'none';
        contentEl.innerHTML = '';
      }

      function render(data) {
        stateEl.style.display = 'none';
        titleEl.style.display = 'block';
        metaEl.style.display = 'block';
        titleEl.textContent = data.title || (TYPES[type] || '文档');
        document.getElementById('page-title').textContent = (TYPES[type] || '协议与政策') + ' · ' + (LANGS[lang] || lang);
        document.getElementById('brand').textContent = (tenant ? '机构' : '平台') + '协议与政策';
        var scope = (data.scopeTenantId === 0 || data.scopeTenantId == null)
          ? '平台统一版本' : '本机构定制版本';
        metaEl.textContent = '版本 v' + (data.version || 1) + ' · ' + (LANGS[data.language] || data.language || '中文') + ' · ' + scope;
        // content 为平台/机构管理员录入的受信任 HTML，直接渲染
        contentEl.innerHTML = data.content || '<p style="color:#6b7587;">（文档内容为空）</p>';
      }

      function load() {
        syncSeg();
        showState('加载中…', false);
        var qs = new URLSearchParams({ type: type, lang: lang });
        if (tenant) qs.set('tenant', tenant);
        fetch(API_BASE + '/legal/doc?' + qs.toString(), { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (json) {
            if (json && json.code === 200 && json.data) {
              render(json.data);
            } else if (json && json.code === 404) {
              showState('《' + (TYPES[type] || '文档') + '》尚未配置，暂无法阅读。', false);
            } else {
              showState((json && json.message) || '加载失败，请稍后重试。', true);
            }
          })
          .catch(function () {
            showState('网络异常，请检查网络连接后重试。', true);
          });
      }

      function changeParam(key, value) {
        var p = new URLSearchParams(location.search);
        p.set(key, value);
        history.replaceState(null, '', location.pathname + '?' + p.toString());
        if (key === 'type') type = value;
        if (key === 'lang') lang = value;
        load();
      }

      document.getElementById('type-seg').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        changeParam('type', b.getAttribute('data-type'));
      });

      // 关闭/返回：优先尝试关闭窗口（target=_blank 打开的新窗口），否则 history.back
      document.getElementById('close-btn').addEventListener('click', function () {
        if (window.opener) {
          window.close();
        } else if (history.length > 1) {
          history.back();
        } else {
          location.href = 'login.html';
        }
      });

      document.getElementById('close-btn').addEventListener('click', function () {
        if (window.opener) { window.close(); return; }
        if (history.length > 1) { history.back(); return; }
        window.close();
      });

      load();
    })();
  </script>
</body>
</html>
