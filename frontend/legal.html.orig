<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="page-title">协议与政策</title>
  <style>
    :root {
      --primary: #722ed1;
      --text: #1f2a44;
      --weak: #6b7587;
      --line: #ebeef5;
      --bg: #f5f7fa;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
    }
    .legal-header {
      position: sticky; top: 0; z-index: 10;
      background: #fff; border-bottom: 1px solid var(--line);
      padding: 14px 20px;
      display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    }
    .legal-title { font-size: 18px; font-weight: 600; margin-right: auto; }
    .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .seg button {
      border: none; background: #fff; color: var(--weak);
      padding: 6px 14px; font-size: 14px; cursor: pointer;
    }
    .seg button.active { background: var(--primary); color: #fff; }
    .close-btn {
      border: 1px solid var(--line); background: #fff; color: var(--text);
      padding: 6px 14px; font-size: 14px; border-radius: 8px; cursor: pointer;
      display: inline-flex; align-items: center; gap: 4px;
    }
    .close-btn:hover { background: var(--bg); }
    /* 语言选择暂不显示（默认中文） */
    #lang-seg { display: none; }
    .legal-main {
      max-width: 860px; margin: 24px auto; padding: 32px 36px;
      background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.06);
      min-height: 50vh;
    }
    .doc-title { font-size: 22px; font-weight: 700; text-align: center; margin: 0 0 6px; }
    .doc-meta { text-align: center; color: var(--weak); font-size: 13px; margin-bottom: 24px; }
    .doc-content { font-size: 15px; color: #2c3650; }
    .doc-content h1, .doc-content h2, .doc-content h3 { color: var(--text); }
    .doc-content p { margin: 10px 0; }
    .doc-content ul, .doc-content ol { padding-left: 22px; }
    .doc-content table { border-collapse: collapse; width: 100%; margin: 12px 0; }
    .doc-content th, .doc-content td { border: 1px solid var(--line); padding: 8px 10px; }
    .legal-state { text-align: center; color: var(--weak); padding: 60px 20px; font-size: 15px; }
    .legal-state.error { color: #f5222d; }
    .legal-footer { text-align: center; color: var(--weak); font-size: 12px; padding: 20px; }
    .close-btn {
      border: 1px solid var(--line); background: #fff; color: var(--weak);
      padding: 6px 14px; font-size: 14px; cursor: pointer; border-radius: 8px;
    }
    .close-btn:hover { color: var(--text); border-color: #d9d9d9; }
    @media (max-width: 640px) {
      .legal-main { margin: 12px; padding: 20px; }
      .legal-title { width: 100%; margin-bottom: 4px; }
    }
  </style>
</head>
<body>
  <div class="legal-header">
    
    <span class="legal-title" id="brand">协议与政策</span>
    <button class="close-btn" id="close-btn">关闭</button>
    <div class="seg" id="type-seg">
      <button data-type="user_agreement">用户协议</button>
      <button data-type="privacy_policy">隐私政策</button>
    </div>
<<<<<<< origin/wx_user_account
