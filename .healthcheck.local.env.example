# 本机巡检凭据模板 —— 复制为 .healthcheck.local.env 后按需修改
#
#   cp .healthcheck.local.env.example .healthcheck.local.env
#
# 为什么是明文而不是 mysql_config_editor：
#   Windows 本机（Git Bash）没有 tty，mysql_config_editor 的密码提示无法非交互应答
#   （实测 winpty 包裹直接 abort：conout != INVALID_HANDLE_VALUE），
#   而 healthcheck.sh 需要免交互执行才能被定时任务驱动。
#   服务器上仍应使用 mysql_config_editor（混淆存储，密码不落进程环境）。
#
# .healthcheck.local.env 已被 .gitignore 忽略，改完可以放心留在本机。

# 数据库凭据（优先用 MYSQL_PWD；留空则巡检会明确告警"未启用"而不是静默跳过）
export MYSQL_PWD="请改成你的密码"

# 连接参数
export DB_HOST="127.0.0.1"
export DB_PORT="3306"
export DB_USER="root"
export DB_NAME="lesson_appointment"

# 可选：覆盖本机日志目录（默认逐个检查 api/logs 与 message-service/logs）
# export LOG_DIR_LOCAL="C:/Users/Administrator/WorkBuddy/2026-08-30-17-19-24/api/logs"

# 可选：巡检间隔秒（仅 --loop 模式生效，默认 300 = 5 分钟，与服务器 cron 对齐）
# export INTERVAL=300