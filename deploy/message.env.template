# ============================================================
# message-service（信息中心）环境变量模板
# 用法：sudo cp message.env.template /etc/lesson/message.env
#       sudo chmod 600 /etc/lesson/message.env && sudo chown lesson:lesson /etc/lesson/message.env
# systemd 单元用 EnvironmentFile=/etc/lesson/message.env 注入
# ------------------------------------------------------------
# 密钥配对关系（★ 已统一由 /etc/lesson/keys.env 提供。此前三处各写一份 JWT_SECRET，正是 2026-11-21 本服务 401 事故的成因）：
#   JWT_SECRET     → jwt.secret      仅校验（api 签发），必须与 booking 相同
#   AES_KEY  → crypto.aes-key  与 booking 相同，方可互通解密 message_center 库字段
#   HMAC_KEY → crypto.hmac-key 与 booking 相同
#   前端（dist）不持有任何密钥。
# ============================================================

# ---------- 数据库凭据：已迁出到 /etc/lesson/keys.env（2026-11-22）----------
# 三个服务连的是同一个 MySQL 实例、同一个账号，本来就是同一份值；
# 分散在三份 xxx.env 里各写一遍，任何一份写错/漏写都只表现为
#   Access denied for user 'lesson'@'localhost' (using password: YES)
# 或（更隐蔽）静默回落 jar 内默认 root/123456 → 每个查库请求卡 30s 后 500。
# 2026-11-22 线上事故即此形态，详见维护手册 §6.7。
# 本文件里若残留生效的 DB_USERNAME= / DB_PASSWORD=，会按 systemd
# 「后加载覆盖先加载」把 keys.env 的值冲掉 —— npm run check:secret-env 会判红。
# DB_USERNAME=lesson
# DB_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/message_center?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# ---------- 共用密钥：已迁出到 /etc/lesson/keys.env ----------
# 本文件**不再定义** JWT_SECRET / AES_KEY / HMAC_KEY。
#
# 原因：systemd 的 EnvironmentFile 是「后加载覆盖先加载」，三个 unit 的顺序是
#       keys.env 在前、本文件在后 --- 只要这里还留着一个键，就会把
#       keys.env 的值**静默覆盖掉**，重新变成「三处各自维护」。
#       2026-11-21 的 message-service 401 事故就是这么来的：
#       三份 env 各写一份 JWT_SECRET，只有 message 那份不同 → 登录成功后立即被踢。
#
# 要改密钥 → **只改 /etc/lesson/keys.env**，然后 systemctl restart 三个服务。
# 下面三行是故意注释的锚点，保留供人打开对照，**不要取消注释**：
#   JWT_SECRET=      （禁用：迁到 keys.env）
#   AES_KEY=         （禁用：迁到 keys.env）
#   HMAC_KEY=        （禁用：迁到 keys.env）

JAVA_OPTS=-Xms128m -Xmx256m -Dfile.encoding=UTF-8

# 日志落盘位置。目录刻意用 message/ 而不是与 booking 同一个 api/，
# 否则两个服务的 spring-boot-app.log 会写进同一目录 —— 排查时根本分不清
# 哪一段堆栈属于谁。详见 booking.env.template 中 LOG_PATH 的完整说明
# 与 deploy/logrotate/lesson 的"两套滚动引擎不可交叉"说明。
LOG_PATH=/var/log/lesson/message

# 显式声明监听端口（与 jar 内 application.properties 的 server.port=8090 一致）。
# 作用：在个别环境若导出了 SERVER_PORT/SERVER__PORT 之类环境变量时，用本文件的值兜底，
# 确保 message-service 稳定监听 8090（而非被环境变量改成其他端口）。Spring 把 SERVER_PORT 映射为 server.port。
SERVER_PORT=8090

# 只监听回环地址（Spring 宽松绑定 → server.address）：8090 由同机 nginx 反代，
# 不对公网/内网开放，避免绕过 nginx 直连；与 booking/classroom 保持同一口径。
# ⚠️ 若与 nginx 不同机，改成内网 IP。
SERVER_ADDRESS=127.0.0.1
