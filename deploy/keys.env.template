# ============================================================
# 文件：deploy/keys.env.template
# 部署到：/etc/lesson/keys.env   （sudo chmod 600 && chown lesson:lesson）
#
# 用途：三个后端服务共用密钥的**唯一权威来源**
#       booking 8081 / message 8090 / classroom 8092
#
# 三份 systemd 单元都按这个顺序加载（deploy/*.service）：
#
#     EnvironmentFile=/etc/lesson/keys.env        ← 本文件：共用密钥
#     EnvironmentFile=/etc/lesson/booking.env     ← 服务私有配置
#
# ★ 顺序不能反：systemd 的规则是「后加载覆盖先加载」，所以共用密钥必须排前面，
#   服务私有文件排后面。同时三份 xxx.env 里**不能再出现本文件定义的任何一个键**
#   （JWT_SECRET / AES_KEY / HMAC_KEY / DB_USERNAME / DB_PASSWORD），
#   否则会把本文件的值静默覆盖掉 —— 这正是 2026-11-21 线上事故的形态：
#   三份 env 各写一份 JWT_SECRET，只有 message 那份与其它两份不同，
#   表现为「登录成功 → 立刻被 401 踢回登录页」，而 booking / classroom 完全正常。
#
# 为什么值得单独拆一个文件：
#   · 原方案靠人工保证三处逐字符一致，任何一次编辑都可能分叉，且**没有任何报错**；
#   · 排查时必须读 /proc/<pid>/environ 才能看到真相，读文件永远看不出来；
#   · 现在是物理上不可能分叉 —— 只有一份值，三个服务都从这里取。
#
# 部署：
#   sudo cp deploy/keys.env.template /etc/lesson/keys.env
#   sudo vi /etc/lesson/keys.env          # 填入真实值
#   sudo chmod 600 /etc/lesson/keys.env
#   sudo chown lesson:lesson /etc/lesson/keys.env
#   sudo systemctl daemon-reload
#   sudo systemctl restart booking message-service classroom
#
# 校验（改完必做，三行必须完全相同）：
#   for s in booking-api message-service classroom-service; do
#     PID=$(pgrep -f "$s.jar" | head -1)
#     printf "%-18s len=%-4s sha16=%s\n" "$s" \
#       "$(sudo tr '\0' '\n' < /proc/$PID/environ | sed -n 's/^JWT_SECRET=//p' | tr -d '\n' | wc -c)" \
#       "$(sudo tr '\0' '\n' < /proc/$PID/environ | sed -n 's/^JWT_SECRET=//p' | tr -d '\n' | sha256sum | cut -c1-16)"
#   done
# ============================================================

# ---------- JWT 签名密钥 ----------
# HS512 要求 **≥64 字节**，否则服务启动即抛
#   IllegalStateException: jwt.secret 长度不足，HS512 至少需要 64 字节
# 生成：openssl rand -base64 64 | tr -d '\n'
#
# ⚠ 换掉本值 = 所有已签发的 access/refresh token 立即失效（用户需重新登录）。
#   除此之外没有副作用，可安全轮换。
JWT_SECRET=CHANGE_ME

# ---------- AES 对称加密密钥 ----------
# 32 字节随机数的 Base64（44 字符，结尾带 =）。
# 生成：openssl rand -base64 32
#
# ⚠⚠ 绝对不要随意重新生成。它用于加密落库的敏感字段（如 user.name），
#    换掉之后**历史密文永久不可解**，且不会报错 —— 只会看到姓名变成乱码。
#    迁移环境时必须从旧环境原样搬过来。
AES_KEY=CHANGE_ME

# ---------- HMAC 签名密钥 ----------
# 32 字节随机数的 Base64。生成：openssl rand -base64 32
#
# ⚠ 同样不要随意重新生成：已签发的数据一旦签名口径变化即校验失败。
HMAC_KEY=CHANGE_ME


# ---------- 数据库凭据（2026-11-22 起并入本文件）----------
# 三个服务连的是**同一个 MySQL 实例、同一个账号**，所以它和密钥一样属于「共用凭据」，
# 必须只有一份值 —— 放在三份 xxx.env 里各写一遍，正是下面这次事故的结构性原因。
#
# ⚠️ 2026-11-22 线上事故：某份 env 的 DB_PASSWORD 与 MySQL 里的不一致，表现为两级症状
#   ① 先卡 30 秒：Hikari 建连被拒 → 池里没有可用连接 → 每个查库请求等 connectionTimeout(30s)
#   ② restart 后立刻暴露：Access denied for user 'lesson'@'localhost' (using password: YES)
#   更阴的是「漏写」—— Spring 静默回落 jar 内默认 ${DB_PASSWORD:123456}，
#   接口只回 {"code":500,"message":"服务器繁忙，请稍后再试"}，日志里也只有一个
#   MyBatisSystemException，完全看不出是密码问题。排查过程见维护手册 §6.7。
#
# ★ host 形态必须分清：MySQL 默认 skip_name_resolve=OFF，从 127.0.0.1 发起的 TCP 连接
#   会被反解成主机名 localhost，命中的是 'lesson'@'localhost'，**不是** 'lesson'@'127.0.0.1'。
#   两个 host 是两个独立账号、各有各的密码。改密码时要么两个一起改，要么先确认命中谁：
#     SELECT user,host,plugin FROM mysql.user WHERE user='lesson';
#
# ★ 改完必须重启三个服务（env 只在进程启动时读取一次）：
#     sudo systemctl restart booking message-service classroom-service
DB_USERNAME=lesson
DB_PASSWORD=CHANGE_ME

# ============================================================
# 本文件的边界：只放**三个服务共用**的凭据（上面的 JWT/AES/HMAC + 数据库账号密码）。
# 端口、数据源 URL、日志路径、业务开关一律留在各自服务的 xxx.env ——
# 它们是「服务私有」的，塞进这里会让本文件变成第二个「什么都往里塞」的垃圾桶。
#
# 常见坑：
#   · 值里不要加引号：systemd 会去掉引号，但手工比对时容易误判成「不一致」；
#   · 行尾不要留空格，编辑后按 cat -A 确认没有 ^M$（CRLF）——
#     多一个 \r 就会让 key 差一字节、验签必然失败；
#   · 文件里同一个键不要出现两次，systemd 取最后一个；
#   · 本文件是 UTF-8 无 BOM，用 Windows 记事本保存会引入 BOM，导致首个键名带 BOM 而失效。
# ============================================================
