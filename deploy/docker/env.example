# ==============================================================================
# lesson 容器化部署 · 版本清单（cp 成 .env 使用，不要直接改这个文件）
#
# 放在 /opt/lesson/docker/.env。switch.sh / rollback.sh 通过改这里的三行 TAG
# 完成「前后版本切换」，compose 读同一份文件启动容器。
# ==============================================================================

# ---------- 后端版本（格式：<pom version>-<git short sha>，由 build-images.sh 生成）----------
# 首次部署前先把镜像 load 进来，再把这三行改成实际 tag；留 init 会拉不到镜像。
BOOKING_TAG=2.2.0-init
MESSAGE_TAG=1.1.0-init
CLASSROOM_TAG=1.0.0-init

# ---------- 前端版本（两种方案二选一，互不干扰）----------
# 方案①「软链」：不容器化，dist 放 /var/www/releases/<FRONTEND_RELEASE>/ 再切软链。
#   由 switch.sh frontend 使用，不需要 FRONTEND_TAG。
# 方案②「镜像」：容器化，镜像 tag 形如 202611210403-9d7221b（由 frontend/build.sh 生成）。
#   需要把 deploy/docker/frontend/compose.fragment.yml 的 frontend 服务合并进
#   docker-compose.yml，并填下面这行；否则 compose 会报 FRONTEND_TAG-not-set。
# 两个都留着不影响：没合并 frontend 服务时 FRONTEND_TAG 用不上。
FRONTEND_RELEASE=init
FRONTEND_TAG=init

# ---------- 前端容器的三个上游（只有方案②用得到）----------
# 后端服务只监听回环，所以只能是 127.0.0.1。若前端容器将来拆到另一台机器，
# 这里改成那台的 http://<内网IP>:<端口>，镜像不用重建。
BOOKING_UPSTREAM=http://127.0.0.1:8081
MSG_UPSTREAM=http://127.0.0.1:8090
CLASSROOM_UPSTREAM=http://127.0.0.1:8092

# 小程序远程配置目录（挂到容器 /app-config，有 app-config.json 就拷进站点根）。
# 目录不存在也没关系：docker 会建空目录，容器跳过拷贝，站点返回 404，
# 小程序自动回落 env.js 里的地址。
APP_CONFIG_DIR=/var/www/app-config

# ---------- 容器运行身份 ----------
# 必须是宿主机 lesson 账号的真实 uid/gid（id -u lesson / id -g lesson）。
# 用于让挂载进来的 /var/log/lesson/** 与 /opt/lesson/data/** 可写；
# 填错的表现是容器起来就退出，日志里一句 "Permission denied"。
LESSON_UID=1000
LESSON_GID=1000

# ---------- 教师上传目录（booking）----------
# 容器内固定用 /app/data/teacher-uploads（HOME 不可靠，见 compose 注释），
# 这里只决定宿主机落在哪。**首次切换到容器前必须把旧目录搬过来**，否则
# 老师头像/资料全 404。旧位置通常是 /home/lesson/teacher-uploads。
TEACHER_UPLOAD_HOST=/opt/lesson/data/teacher-uploads
