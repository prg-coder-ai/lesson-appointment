# ============================================================
#  lesson 预约系统 —— systemd 捕获的 stdout/stderr 日志滚动
#  安装：sudo cp deploy/logrotate/lesson /etc/logrotate.d/lesson
#        sudo chown root:root /etc/logrotate.d/lesson && sudo chmod 644 /etc/logrotate.d/lesson
#  校验：sudo logrotate -d /etc/logrotate.d/lesson   （-d 是dry-run，不会真转）
#        sudo logrotate -f /etc/logrotate.d/lesson   （强制转一次确认权限）
#  校验必须做的原因：logrotate 若没有 -d 跑过，配置里su/copytruncate 写错不会报错，
#  等真正需要滚动那天才发现 —— 那正是磁盘已满的时候。
# ------------------------------------------------------------
#  ⚠️ 本文件**只管systemd 直接写的那两份**：
#/var/log/lesson/booking.log     ← booking.service   StandardOutput=append:
#     /var/log/lesson/message.log    ← message-service.service StandardOutput=append:
#
#  app 自己的业务日志（spring-boot-app.log 及其 archived/*.gz）**不在本文件管辖内**，
#  由 logback-spring.xml 的 SizeAndTimeBasedRollingPolicy负责
#  （50MB 单文件 / 30 天 / 5GB 总量三重保险，见各服务的 LOG_PATH 环境变量）。
#
#  两者必须物理隔离成不同目录，否则**两套滚动引擎会互相踩**：
#  logrotate 把文件转走而 logback 还持有 fd → logback 继续往已重命名的新 inode 写，
#  于是"当前文件"永远空；反过来 logback 转走而 logrotate 按名字找不到 → 报no such file。
#  env模板里 LOG_PATH 分别指向 /var/log/lesson/api 与 /var/log/lesson/message，
#  就是为了和这里的 /var/log/lesson/*.log 错开一层。
# ============================================================

/var/log/lesson/*.log {
    # 按天滚动；若单文件一天内就超 100MB 则提前触发（maxsize 优先于 daily）
    daily
    rotate 14
    maxsize 100M

    missingok
    notifempty

    compress
    delaycompress
    dateext
    dateformat -%Y%m%d
    dateyesterday

    # ⚠️ 必须用 copytruncate，不能用 create。
    # create 的做法是：新建文件 + 把进程持有的旧 fd 指过去（需要进程配合 reopen）。
    # Java 进程不会 reopen stdout，所以 create 之后 logrotate 立刻就报
    # "error: could not change state of 'xxx.log' to 'immutable'" 或文件持续增长。
    # copytruncate 是"复制内容 → 清空原文件"，进程无感，代价是滚动瞬间可能丢几行日志
    # （对"服务启动失败要抓堆栈"这种场景可接受：堆栈在开头几秒就写完了）。
    # 附带效应：copytruncate 会保留原文件的属主与权限，故**不需要** create 指令
    #（写了也会被忽略，反而让人误以为属主由 create 决定）。
    copytruncate

    # systemd 以 User=lesson 写入，文件属主是 lesson。logrotate 默认以 root 跑，
    # 压缩归档时会生成 root 属主的文件；若不指定 su，
    # 下次滚动时 logrotate 要以 lesson 身份写归档目录会失败。
    # 需 logrotate >= 3.9（RHEL7/CentOS7 自带 3.8.6 报 unknown directive，需先升级）。
    su lesson lesson
}