.page { min-height: 100vh; background: #f5f7fa; padding: 24rpx; }
.field { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 18rpx; }
.label { font-size: 26rpx; color: #888; margin-bottom: 14rpx; }
.radio-row { display: flex; flex-wrap: wrap; gap: 24rpx; }
.radio { font-size: 28rpx; color: #333; }
.picker {
  padding: 18rpx 20rpx; background: #f7f9fc; border: 1rpx solid #e5e8ef; border-radius: 12rpx;
  font-size: 28rpx; color: #333;
}
.input {
  padding: 18rpx 20rpx; background: #f7f9fc; border: 1rpx solid #e5e8ef; border-radius: 12rpx;
  font-size: 28rpx;
}
.textarea {
  width: 100%; box-sizing: border-box; min-height: 160rpx; padding: 18rpx 20rpx;
  background: #f7f9fc; border: 1rpx solid #e5e8ef; border-radius: 12rpx; font-size: 28rpx;
}
.btn { background: #fff; color: #333; border: 1rpx solid #e5e8ef; border-radius: 12rpx; font-size: 28rpx; }
.btn.primary { background: #1890ff; color: #fff; border-color: #1890ff; }
.btn.block { width: 100%; margin-top: 8rpx; }
.send { margin-top: 8rpx; }
.tip { text-align: center; font-size: 23rpx; color: #aaa; margin-top: 16rpx; padding: 0 10rpx; }

.rcpt { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; margin-bottom: 18rpx; }
.rcpt-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.rcpt-item:last-child { border-bottom: none; }
.rcpt-check {
  width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; margin-right: 18rpx;
  border: 1rpx solid #c8cdd6; border-radius: 50%; font-size: 24rpx; color: #fff;
}
.rcpt-check.on { background: #1890ff; border-color: #1890ff; }
.rcpt-name { flex: 1; font-size: 28rpx; color: #333; }
.rcpt-role { font-size: 24rpx; color: #aaa; }
