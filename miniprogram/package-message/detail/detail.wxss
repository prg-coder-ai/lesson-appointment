.page { min-height: 100vh; background: #f5f7fa; padding: 24rpx; }
.tip { text-align: center; color: #999; padding: 80rpx 0; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #222; }
.meta { margin-top: 18rpx; display: flex; align-items: center; flex-wrap: wrap; }
.tag { font-size: 22rpx; color: #1890ff; background: #e6f4ff; border-radius: 8rpx; padding: 4rpx 14rpx; margin-right: 14rpx; }
.tag.warn { color: #fa8c16; background: #fff7e6; }
.time { font-size: 24rpx; color: #aaa; }
.sender { margin-top: 16rpx; font-size: 26rpx; color: #666; }
.body .content { font-size: 30rpx; color: #333; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.actions { display: flex; gap: 20rpx; margin-top: 10rpx; }
.btn { flex: 1; background: #fff; color: #333; border: 1rpx solid #e5e8ef; border-radius: 12rpx; font-size: 28rpx; }
.btn-star { color: #faad14; border-color: #ffe58f; }
.btn-del { color: #fa5151; border-color: #ffccc7; }
