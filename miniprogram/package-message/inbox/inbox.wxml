<view class="page">
  <!-- 顶部标题栏 -->
  <view class="topbar">
    <view class="tb-title">消息中心</view>
    <view class="tb-right">
      <view wx:if="{{unreadCount > 0}}" class="tb-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      <view class="tb-refresh {{refreshing ? 'spin' : ''}}" bindtap="onRefreshTap">🔄</view>
    </view>
  </view>

  <!-- 文件夹标签页 -->
  <view class="tabs">
    <view class="tab {{folder === 'inbox' ? 'on' : ''}}" data-folder="inbox" bindtap="switchFolder">收件箱</view>
    <view class="tab {{folder === 'starred' ? 'on' : ''}}" data-folder="starred" bindtap="switchFolder">收藏</view>
    <view class="tab {{folder === 'trash' ? 'on' : ''}}" data-folder="trash" bindtap="switchFolder">回收站</view>
    <view wx:if="{{showSent}}" class="tab {{folder === 'sent' ? 'on' : ''}}" data-folder="sent" bindtap="switchFolder">已发</view>
    <view wx:if="{{showManage}}" class="tab {{folder === 'manage' ? 'on' : ''}}" data-folder="manage" bindtap="switchFolder">管理</view>
  </view>

  <!-- 工具栏（非选择态） -->
  <view wx:if="{{!selecting}}" class="toolbar">
    <view wx:if="{{folder !== 'sent' && folder !== 'manage'}}" class="search">
      <input class="search-input" placeholder="搜索标题关键词" value="{{keyword}}" bindinput="searchInput" confirm-type="search" bindconfirm="onSearch" />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
    <view class="tools-right">
      <view wx:if="{{folder === 'inbox'}}" class="tool-btn" bindtap="markAllReadTap">全部已读</view>
      <view wx:if="{{folder !== 'sent' && folder !== 'manage'}}" class="tool-btn" bindtap="enterSelect">选择</view>
      <view wx:if="{{canSend}}" class="tool-btn primary" bindtap="goCompose">发送通知</view>
    </view>
  </view>

  <!-- 仅看未读（收件箱/收藏/回收站） -->
  <view wx:if="{{folder !== 'sent' && folder !== 'manage' && !selecting}}" class="filterbar">
    <view class="seg">
      <view class="seg-item {{!onlyUnread ? 'on' : ''}}" data-val="0" bindtap="onToggleUnread">全部</view>
      <view class="seg-item {{onlyUnread ? 'on' : ''}}" data-val="1" bindtap="onToggleUnread">仅看未读</view>
    </view>
  </view>

  <!-- 分类筛选（收件箱/收藏/回收站） -->
  <scroll-view wx:if="{{folder !== 'sent' && folder !== 'manage' && categories.length && !selecting}}" class="cats" scroll-x="true">
    <view class="cat-item {{activeCategory === '' ? 'on' : ''}}" data-code="" bindtap="onPickCategory">全部分类</view>
    <view wx:for="{{categories}}" wx:key="code" class="cat-item {{item.level === 2 ? 'sub' : ''}} {{activeCategory === item.code ? 'on' : ''}}" data-code="{{item.code}}" bindtap="onPickCategory">{{item.name}}</view>
  </scroll-view>

  <!-- 管理页内双台账：发送台账（本租户发出，发送方视角）/ 接收台账（平台方发来的，接收方视角） -->
  <view wx:if="{{folder === 'manage' && !selecting}}" class="manage-tabs">
    <view class="mtab {{manageTab === 'sent' ? 'on' : ''}}" data-tab="sent" bindtap="switchManageTab">发送台账</view>
    <view class="mtab {{manageTab === 'ledger' ? 'on' : ''}}" data-tab="ledger" bindtap="switchManageTab">接收台账</view>
  </view>

  <!-- 发送台账筛选（状态 / 发送者） -->
  <view wx:if="{{folder === 'manage' && manageTab === 'sent' && !selecting}}" class="filterbar manage-filters">
    <picker class="filter-picker" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="picker-inner">状态：{{statusOptions[statusIndex]}}</view>
    </picker>
    <picker class="filter-picker" range="{{senderOptions}}" value="{{senderIndex}}" bindchange="onSenderChange">
      <view class="picker-inner">发送者：{{senderOptions[senderIndex]}}</view>
    </picker>
  </view>

  <!-- 接收台账筛选（读状态） -->
  <view wx:if="{{folder === 'manage' && manageTab === 'ledger' && !selecting}}" class="filterbar manage-filters">
    <picker class="filter-picker" range="{{ledgerReadOptions}}" value="{{ledgerReadIndex}}" bindchange="onLedgerReadChange">
      <view class="picker-inner">读状态：{{ledgerReadOptions[ledgerReadIndex]}}</view>
    </picker>
  </view>

  <!-- 列表 -->
  <view wx:if="{{loading && list.length === 0}}" class="tip">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty-glyph">📭</view>
    <view>暂无消息</view>
  </view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="msg">
      <view wx:if="{{selecting}}" class="check {{item.checked ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onCheckItem">{{item.checked ? '✓' : ''}}</view>
      <view wx:if="{{!selecting && folder !== 'sent' && item.unread}}" class="dot"></view>
      <view class="msg-main" data-id="{{item.id}}" bindtap="goDetail">
        <view class="msg-row">
          <text class="msg-title">{{item.title}}</text>
          <text wx:if="{{folder !== 'sent' && folder !== 'manage' && item.starred}}" class="star">★</text>
        </view>
        <view class="msg-preview" wx:if="{{folder !== 'sent' && folder !== 'manage'}}">{{item.preview || '（无内容）'}}</view>
        <view class="msg-preview" wx:if="{{folder === 'manage'}}">发送者：{{item.sender}}</view>
        <view class="msg-meta">
          <text wx:if="{{folder === 'sent'}}" class="tag">接收 {{item.recipientCount}} 人 · 已读 {{item.readCount}} 人</text>
          <text wx:if="{{folder === 'manage' && manageTab === 'sent'}}" class="tag">{{item.statusText}}</text>
          <!-- 接收台账：本租户接收人数 + 还有几人没看（台账最关心的就是"谁还没看"） -->
          <text wx:if="{{folder === 'manage' && manageTab === 'ledger'}}" class="tag">{{item.statusText}}</text>
          <text wx:if="{{folder === 'manage' && manageTab === 'ledger'}}" class="tag">本租户接收 {{item.recipientCount}} 人</text>
          <text wx:if="{{folder === 'manage' && manageTab === 'ledger'}}" class="tag warn">未读 {{item.unreadCount}} 人</text>
          <text wx:if="{{item.category}}" class="tag">{{item.category}}</text>
          <text wx:if="{{item.priority}}" class="pri pri-{{item.priorityCode}}">{{item.priority}}</text>
          <text class="time">{{item.time}}</text>
        </view>
      </view>
      <view wx:if="{{!selecting && folder === 'manage' && manageTab === 'sent'}}" class="row-del" data-id="{{item.id}}" bindtap="onRowDelete">彻底删除</view>
      <view wx:if="{{!selecting && folder !== 'manage'}}" class="more" data-id="{{item.id}}" bindtap="onItemAction">⋯</view>
    </view>
    <view wx:if="{{loading && list.length > 0}}" class="tip">加载中…</view>
    <view wx:if="{{finished && list.length > 0}}" class="tip dim">— 没有更多了 —</view>
  </view>

  <!-- 选择态底部操作栏 -->
  <view wx:if="{{selecting}}" class="selbar">
    <view class="sel-info">已选 {{selectedCount}} 项</view>
    <view class="sel-actions">
      <view class="sel-btn" bindtap="exitSelect">取消</view>
      <view wx:if="{{folder !== 'trash' && folder !== 'sent'}}" class="sel-btn" bindtap="batchReadTap">批量已读</view>
      <view class="sel-btn danger" bindtap="batchDeleteTap">{{folder === 'trash' ? '批量彻底删除' : '批量删除'}}</view>
    </view>
  </view>
</view>
