.page { min-height: 100vh; background: #f5f7fa; }
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx; background: #fff; border-bottom: 1rpx solid #eee;
}
.tb-title { font-size: 34rpx; font-weight: 600; }
.tb-right { display: flex; align-items: center; }
.tb-badge {
  min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 8rpx;
  background: #fa5151; color: #fff; font-size: 22rpx; border-radius: 16rpx;
  text-align: center; margin-right: 18rpx;
}
.tb-refresh { font-size: 38rpx; }
.tb-refresh.spin { animation: spin 0.8s linear infinite; }
@keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.filterbar { padding: 18rpx 24rpx 6rpx; }
.seg { display: inline-flex; background: #eef1f6; border-radius: 12rpx; padding: 4rpx; }
.seg-item { padding: 10rpx 26rpx; font-size: 26rpx; color: #555; border-radius: 10rpx; }
.seg-item.on { background: #fff; color: #1890ff; font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06); }

.cats { white-space: nowrap; padding: 10rpx 24rpx; }
.cat-item { display: inline-block; padding: 8rpx 22rpx; margin-right: 12rpx; background: #fff; border: 1rpx solid #e5e8ef; border-radius: 28rpx; font-size: 24rpx; color: #555; }
.cat-item.on { background: #e6f4ff; color: #1890ff; border-color: #91d5ff; }

.tip, .empty { text-align: center; color: #999; padding: 80rpx 0; font-size: 28rpx; }
.empty-glyph { font-size: 80rpx; margin-bottom: 16rpx; }

.list { padding: 8rpx 24rpx 40rpx; }
.msg {
  display: flex; align-items: flex-start; background: #fff; border-radius: 16rpx;
  padding: 24rpx 24rpx; margin-bottom: 16rpx; position: relative;
}
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #fa5151; margin-top: 12rpx; margin-right: 16rpx; flex: none; }
.msg-main { flex: 1; min-width: 0; }
.msg-row { display: flex; align-items: center; justify-content: space-between; }
.msg-title { font-size: 30rpx; font-weight: 600; color: #222; }
.star { color: #faad14; font-size: 28rpx; }
.msg-preview { font-size: 26rpx; color: #888; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.msg-meta { margin-top: 12rpx; display: flex; align-items: center; }
.tag { font-size: 22rpx; color: #1890ff; background: #e6f4ff; border-radius: 8rpx; padding: 2rpx 12rpx; margin-right: 14rpx; }
.time { font-size: 22rpx; color: #aaa; }
