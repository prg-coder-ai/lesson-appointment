    <view class="row"><text class="label">student</text><text>{{student}}</text></view>
    <view class="row"><text class="label">lesson</text><text>{{lesson}}</text></view>
    <view class="row"><text class="label">courseType french</text><text>{{french}}</text></view>
    <view class="row"><text class="label">courseType english</text><text>{{english}}</text></view>
