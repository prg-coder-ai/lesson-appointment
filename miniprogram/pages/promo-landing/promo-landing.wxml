<view class="page">
  <view class="hero">
    <view class="hero-icon">🎁</view>
    <view class="hero-title">{{pathType === 2 ? '邀请你加入' + (orgName || '本机构') : '邀请你免费开通新租户'}}</view>
    <view class="hero-sub" wx:if="{{loading}}">正在校验邀请信息…</view>
    <view class="hero-sub" wx:elif="{{valid && pathType === 1}}">通过平台推广码自助开通，免费体验 {{trialDays}} 天</view>
    <view class="hero-sub" wx:elif="{{valid && pathType === 2}}">加入后即可使用本机构的预约服务（需管理员审批）</view>
    <view class="hero-sub" wx:else>该邀请链接无效或已被停用，你仍可正常使用本小程序</view>
  </view>

  <view class="card" wx:if="{{!loading && valid}}">
    <view class="row"><text class="rk">邀请码</text><text class="rv code">{{ref}}</text></view>
    <view class="row" wx:if="{{pathType === 2}}"><text class="rk">所属机构</text><text class="rv">{{orgName || '-'}}</text></view>
    <view class="row"><text class="rk">邀请类型</text><text class="rv">{{pathType === 2 ? '加入租户' : '自助开通新租户'}}</text></view>
  </view>

  <view class="card" wx:if="{{!loading && !valid}}">
    <view class="tip">推广码 {{ref || '（缺失）'}} 无效或已停用</view>
  </view>

  <view class="cta" hover-class="cta-hover" bindtap="enter">进入小程序</view>
  <view class="foot">进入后可直接登录；新用户可按页面指引完成注册</view>
</view>
