<view class="reg-page">
  <view class="brand">免费体验注册</view>
  <view class="subtitle">通过推广码自助开通新机构，免费试用</view>

  <block wx:if="{{!done}}">
    <view class="field">
      <text class="label">机构名称</text>
      <input class="input" placeholder="请输入机构/工作室名称" value="{{orgName}}" bindinput="onOrg" />
    </view>
    <view class="field">
      <text class="label">管理员账号(邮箱或手机号)</text>
      <input class="input" placeholder="将作为本机构的管理员登录账号" value="{{account}}" bindinput="onAccount" />
    </view>
    <view class="field">
      <text class="label">联系人姓名</text>
      <input class="input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="label">联系电话</text>
      <input class="input" placeholder="请输入联系电话（选填）" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" placeholder="请设置登录密码" password value="{{password}}" bindinput="onPwd" />
    </view>
    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" placeholder="请再次输入密码" password value="{{password2}}" bindinput="onPwd2" />
    </view>
    <view class="field">
      <text class="label">所属行业</text>
      <picker mode="selector" range="{{industries}}" range-key="name" bindchange="onIndustry">
        <view class="input picker">{{industryIndex !== '' && industries[industryIndex] ? industries[industryIndex].name : '请选择所属行业'}}</view>
      </picker>
    </view>

    <view class="agree" bindtap="toggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}"></view>
      <text class="agree-text">我已阅读并同意</text>
      <text class="link" catchtap="openAgreement">《用户协议》《隐私政策》</text>
    </view>

    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">立即创建</button>
  </block>

  <block wx:else>
    <view class="success-card">
      <view class="success-icon">✓</view>
      <view class="success-title">注册成功</view>
      <view class="success-line">机构租户编码：<text class="code">{{tenantCode}}</text></view>
      <view class="success-line">免费体验 {{trialDays}} 天</view>
      <view class="success-tip">请用管理员账号登录管理端。</view>
      <button class="btn-primary" bindtap="enter">进入</button>
    </view>
  </block>
</view>
