.login-page {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fa 40%);
}
.brand {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2a44;
  text-align: center;
}
.subtitle {
  font-size: 26rpx;
  color: #8a94a6;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}
.bound-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  color: #ad6800;
  font-size: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.bound-code { font-weight: 600; }
.bound-switch { color: #1677ff; margin-left: 12rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.06);
}
.field { margin-bottom: 28rpx; }
.label {
  display: block;
  font-size: 26rpx;
  color: #5a6478;
  margin-bottom: 12rpx;
}
.input {
  height: 84rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2a44;
}
.role-seg {
  display: flex;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 6rpx;
}
.role-item {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #5a6478;
  border-radius: 8rpx;
}
.role-item.active {
  background: #fff;
  color: #1677ff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(22,119,255,0.15);
}
.btn-primary {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
}
.btn-primary::after { border: none; }
.hint {
  font-size: 22rpx;
  color: #aab2c0;
  text-align: center;
  margin-top: 32rpx;
}
