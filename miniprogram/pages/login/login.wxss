.login-page {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4ff 0%, #f5f7fa 40%);
}
.brand {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2a44;
  text-align: center;
}
.subtitle {
  font-size: 26rpx;
  color: #6b7587;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}
.bound-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  color: #ad6800;
  font-size: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.bound-code { font-weight: 600; }
.bound-switch { color: #1677ff; margin-left: 12rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.06);
}
/* app.wxss 全局把 .field 定义成 flex 行布局（label 左 / 控件右），
   登录页沿用这个布局；允许换行是为了让「平台管理员」提示能独占一行，不挤压右侧控件 */
.field { margin-bottom: 28rpx; flex-wrap: wrap; }
.label {
  display: block;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #5a6478;
  margin-bottom: 12rpx;
}
.input {
  /* 与 .role-seg 同为 flex:1，两者占满 label 右侧同一份剩余宽度 */
  flex: 1;
  min-width: 0;
  height: 84rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2a44;
}
.tenant-hint {
  flex: 0 0 100%;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1677ff;
  background: #e6f0ff;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}
.role-seg {
  /* 全局 .field 是 flex 行：必须显式 flex:1 才占满 label 右侧剩余宽度、与 .input 等宽。
     不写的话 width:auto 在 flex 项上退化成"内容宽"，三个 flex:1 1 0 子项会把整条压到最窄 */
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 6rpx;
}
.role-item {
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
  text-align: center;
  /* 单行显示 + 行高撑满：原实现上下各 10rpx padding 配固定 72rpx 行高，
     行业词表替换成长词时会换行，第二行被固定高度裁掉（表现为"显示不完整"） */
  white-space: nowrap;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  padding: 0 6rpx;
  color: #5a6478;
  border-radius: 8rpx;
}
.role-item.active {
  background: #fff;
  color: #1677ff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(22,119,255,0.15);
}
.btn-primary {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
}
.btn-primary::after { border: none; }
.hint {
  font-size: 22rpx;
  color: #6b7587;
  text-align: center;
  margin-top: 32rpx;
}
.agree {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: #6b7587;
  margin: 8rpx 0 28rpx;
}
.checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #c5ccd6;
  border-radius: 6rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  position: relative;
  flex-shrink: 0;
}
.checkbox.checked {
  background: #1677ff;
  border-color: #1677ff;
}
.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.agree-text { line-height: 32rpx; }
.link { color: #1677ff; margin-left: 4rpx; }
