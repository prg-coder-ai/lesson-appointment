.legal-page { padding: 24rpx 28rpx 60rpx; background: #f5f7fa; min-height: 100vh; }
.state { text-align: center; color: #8a94a6; font-size: 28rpx; margin-top: 120rpx; }
.doc-block { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.doc-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; border-bottom: 1rpx solid #eef0f4; padding-bottom: 14rpx; }
.doc-title { font-size: 32rpx; font-weight: 600; color: #1f2430; }
.doc-meta { font-size: 22rpx; color: #aab2c0; }
.doc-content { font-size: 28rpx; color: #3a4252; line-height: 1.7; }
