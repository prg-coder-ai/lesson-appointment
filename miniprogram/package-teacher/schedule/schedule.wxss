.page { min-height: 100vh; background: #f5f7fa; padding: 24rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.tb-title { font-size: 34rpx; font-weight: 600; }
.tb-add { background: #1890ff; color: #fff; font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 30rpx; }
.tip, .empty { text-align: center; color: #999; padding: 80rpx 0; }
.empty-glyph { font-size: 80rpx; margin-bottom: 16rpx; }

.list { margin-top: 8rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.item-top { display: flex; align-items: center; justify-content: space-between; }
.it-title { font-size: 30rpx; font-weight: 600; color: #222; }
.it-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.s-active { color: #389e0d; background: #f6ffed; }
.s-frozen { color: #8c8c8c; background: #fafafa; }
.s-pending { color: #d46b08; background: #fff7e6; }
.s-inactive { color: #8c8c8c; background: #f5f5f5; }
.it-range { font-size: 26rpx; color: #666; margin-top: 12rpx; }
.it-meta { margin-top: 12rpx; display: flex; align-items: center; flex-wrap: wrap; }
.tag { font-size: 22rpx; color: #1890ff; background: #e6f4ff; border-radius: 8rpx; padding: 4rpx 14rpx; margin-right: 12rpx; }
.tag.full { color: #fa5151; background: #fff1f0; }
.item-actions { margin-top: 20rpx; display: flex; gap: 36rpx; border-top: 1rpx solid #f0f0f0; padding-top: 16rpx; }
.act { font-size: 26rpx; color: #1890ff; }
.act.danger { color: #fa5151; }
