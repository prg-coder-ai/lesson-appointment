<view class="page">
  <view class="form">
    <!-- 「课程」标签走行业词：教育「课程」/法律「咨询话题」/心理「咨询项目」/健身「健身科目」 -->
    <view class="fld">
      <text class="lab">{{terms.course || '课程'}}</text>
      <picker wx:if="{{courses.length}}" mode="selector" range="{{courses}}" range-key="courseName" value="{{courseIndex}}" bindchange="onCourse">
        <view class="picker {{courseLabel ? '' : 'ph'}}">{{courseLabel || ('请选择' + (terms.course || '课程'))}}</view>
      </picker>
      <view wx:else class="picker ph">暂无{{terms.course || '课程'}}</view>
    </view>

    <view class="fld">
      <text class="lab">{{terms.schedule || '排期'}}名称</text>
      <input class="inp" placeholder="留空则与{{terms.course || '课程'}}同名" value="{{form.name}}" bindinput="onName" />
    </view>

    <view class="fld">
      <text class="lab">{{terms.schedule || '排期'}}时区</text>
      <view class="picker ro">{{form.timeZone || '—'}}</view>
    </view>

    <view class="fld">
      <text class="lab">开始日期</text>
      <picker mode="date" value="{{form.startDate}}" bindchange="onStartDate">
        <view class="picker {{form.startDate ? '' : 'ph'}}">{{form.startDate || '请选择'}}</view>
      </picker>
    </view>
    <view class="fld-row">
      <view class="fld half">
        <text class="lab">{{terms.lessonTime || '上课时间'}}</text>
        <picker mode="time" value="{{form.startTime}}" bindchange="onStartTime"><view class="picker">{{form.startTime}}</view></picker>
      </view>
      <view class="fld half">
        <text class="lab">结束时间</text>
        <picker mode="time" value="{{form.endTime}}" bindchange="onEndTime"><view class="picker">{{form.endTime}}</view></picker>
      </view>
    </view>
    <view class="fld">
      <text class="lab">结束日期</text>
      <picker mode="date" value="{{form.endDate}}" bindchange="onEndDate">
        <view class="picker {{form.endDate ? '' : 'ph'}}">{{form.endDate || (form.repeatType > 0 ? '重复排期必填' : '不重复可留空')}}</view>
      </picker>
    </view>

    <view class="fld">
      <text class="lab">重复方式</text>
      <picker mode="selector" range="{{repeatOpts}}" range-key="label" value="{{form.repeatType}}" bindchange="onRepeat">
        <view class="picker">{{repeatOpts[form.repeatType].label}}</view>
      </picker>
    </view>

    <view wx:if="{{form.repeatType > 0}}" class="fld">
      <text class="lab">重复间隔（每 N {{repeatUnit}}）</text>
      <input class="inp" type="text" value="{{form.intervalInput}}" bindinput="onIntervalInput" bindblur="onIntervalBlur" />
    </view>

    <!-- 每周：星期多选（1=周一 … 7=周日），后端 repeat_days 存 "1,3,5" -->
    <view wx:if="{{form.repeatType === 2}}" class="fld">
      <text class="lab">每周星期（可多选）</text>
      <view class="chips">
        <text wx:for="{{weekDays}}" wx:key="v" class="chip {{form.repeatDays.indexOf(item.v) >= 0 ? 'on' : ''}}" data-v="{{item.v}}" bindtap="onDayPick">周{{item.label}}</text>
      </view>
      <text class="hint">开始日期当天若不在所选星期，会自动顺延到下一个匹配日。</text>
    </view>

    <!-- 每月：当月日期多选（1-31），与 Web 端 #monthDays 复选框同口径 -->
    <view wx:if="{{form.repeatType === 3}}" class="fld">
      <text class="lab">每月日期（可多选，1-31）</text>
      <view class="chips day-grid">
        <text wx:for="{{monthDays}}" wx:key="*this" class="chip num {{form.repeatDays.indexOf(item) >= 0 ? 'on' : ''}}" data-v="{{item}}" bindtap="onDayPick">{{item}}</text>
      </view>
      <text class="hint">某月没有所选日期（如 2 月 30 日）时，该月自动跳过。</text>
    </view>

    <view class="fld">
      <text class="lab">可预约名额</text>
      <view class="stepper">
        <text class="st-btn" data-d="-1" bindtap="onSitesStep">−</text>
        <input class="inp st-inp" type="text" value="{{form.sitesInput}}" bindinput="onSitesInput" bindblur="onSitesBlur" />
        <text class="st-btn" data-d="1" bindtap="onSitesStep">＋</text>
      </view>
      <text class="hint">可填 {{sitesMin}}-{{sitesMax}}；编辑时不可低于已占用的席位数。</text>
    </view>

    <!-- 状态：四态选择（待发布/已发布/已冻结/已收回）。原来用二值 switch，
         pending 排期一进保存就被改写成 frozen，属于「没改也变」。 -->
    <view class="fld">
      <text class="lab">状态</text>
      <picker mode="selector" range="{{statusOpts}}" range-key="label" value="{{statusIndex}}" bindchange="onStatus">
        <view class="picker">{{statusOpts[statusIndex].label}}</view>
      </picker>
    </view>
  </view>

  <button class="btn-save" loading="{{submitting}}" bindtap="save">{{mode === 'edit' ? '保存修改' : '创建' + (terms.schedule || '排期')}}</button>
</view>
