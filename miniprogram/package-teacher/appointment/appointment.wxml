<view class="page">
  <view class="topbar">
    <view class="tb-title">今日课程</view>
    <view class="tb-days">
      <text class="day {{days===1?'on':''}}" data-days="1" bindtap="onDayChange">1天</text>
      <text class="day {{days===3?'on':''}}" data-days="3" bindtap="onDayChange">3天</text>
      <text class="day {{days===7?'on':''}}" data-days="7" bindtap="onDayChange">7天</text>
      <text class="day {{days===-1?'on':''}}" data-days="-1" bindtap="onDayChange">全部</text>
    </view>
  </view>

  <scroll-view scroll-x class="status-bar">
    <text wx:for="{{statusOptions}}" wx:key="v" class="st {{status===item.v?'on':''}}" data-s="{{item.v}}" bindtap="onStatusChange">{{item.t}}</text>
  </scroll-view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{list.length===0}}" class="empty">
    <view class="empty-glyph">📚</view>
    <view>近期没有课程安排</view>
  </view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="item" bindtap="goSchedule" data-id="{{item.courseId}}">
      <view class="it-top">
        <text class="it-title">{{item.title}}</text>
        <text class="it-status s-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="it-sub">{{item.sub}}</view>
      <view class="it-time" wx:if="{{item.time}}">🕒 {{item.time}}</view>
      <view class="it-go">查看排期 ›</view>
    </view>
  </view>

  <role-tabbar active="home" bind:change="onTabChange" />
</view>
