.page { min-height: 100vh; padding: 24rpx 24rpx 140rpx; box-sizing: border-box; background: #f5f7fa; }
.hero { background: linear-gradient(135deg, #1677ff, #4096ff); border-radius: 20rpx; padding: 36rpx 32rpx; color: #fff; }
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.9; margin-top: 10rpx; }
.card { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.05); }
.card-title { font-size: 30rpx; font-weight: 600; color: #1f2a44; margin-bottom: 16rpx; }
.card-text { font-size: 27rpx; color: #5a6478; line-height: 1.7; white-space: pre-wrap; }
.empty { text-align: center; color: #aab2c0; font-size: 28rpx; padding: 120rpx 0; }
