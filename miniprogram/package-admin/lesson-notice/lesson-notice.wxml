<view class="page">
  <view class="bar">
    <text class="bar-title">近期上课</text>
    <button class="btn" size="mini" bindtap="onNotify">发送提醒</button>
  </view>

  <view wx:if="{{loading}}" class="center">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="center">暂无已确认课程</view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="row1"><text class="name">{{item.course || '课程'}}</text></view>
      <view class="row2"><text class="meta">学生 {{item.student || '-'}}</text><text class="meta">教师 {{item.teacher || '-'}}</text></view>
      <view class="row2"><text class="meta">时间 {{item.time || '-'}}</text></view>
    </view>
  </view>
</view>
