.page { min-height: 100vh; padding: 24rpx 24rpx 40rpx; box-sizing: border-box; background: #f5f7fa; }

/* 检索栏 */
.filter { background: #fff; border-radius: 16rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(31,42,68,0.05); }
.f-row { display: flex; align-items: center; gap: 16rpx; }
.f-row + .f-row { margin-top: 16rpx; }
.f-input { flex: 1; height: 64rpx; line-height: 64rpx; padding: 0 20rpx; font-size: 26rpx; color: #1f2a44; background: #f5f7fa; border-radius: 12rpx; box-sizing: border-box; }
.f-btn { margin: 0; flex: none; background: #2b7de9; color: #fff; font-size: 24rpx; }
.f-btn.ghost { background: #eef2f7; color: #5a6478; }
.f-pick { flex: 1; }
.f-picker { height: 64rpx; line-height: 64rpx; padding: 0 20rpx; font-size: 26rpx; color: #1f2a44; background: #f5f7fa; border-radius: 12rpx; }
.f-picker::after { content: ' ▾'; color: #6b7587; font-size: 22rpx; }
.f-hint { margin-top: 14rpx; font-size: 22rpx; color: #6b7587; }

.center { text-align: center; color: #6b7587; padding: 80rpx 0; }
.list { margin-top: 16rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(31,42,68,0.05); }
.row1 { display: flex; align-items: center; justify-content: space-between; }
.name { font-size: 30rpx; font-weight: 600; color: #1f2a44; }
.status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 16rpx; background: #eef3ff; color: #2b7de9; }
.status.ok { background: #e8f7ee; color: #18a058; }
.status.warn { background: #fff5e6; color: #d48806; }
.status.done { background: #eef1f5; color: #5a6478; }
.status.bad { background: #fdecec; color: #fa5151; }
.row2 { margin-top: 10rpx; display: flex; gap: 24rpx; }
.meta { font-size: 24rpx; color: #6b7587; }

.actions { margin-top: 18rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.btn { margin: 0; font-size: 24rpx; }
.btn.ok { background: #18a058; color: #fff; }
.btn.no { background: #fa5151; color: #fff; }

.more { text-align: center; color: #6b7587; font-size: 24rpx; padding: 24rpx 0; }
