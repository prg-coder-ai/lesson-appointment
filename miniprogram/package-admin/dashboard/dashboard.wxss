.page { min-height: 100vh; padding: 24rpx 24rpx 140rpx; box-sizing: border-box; background: #f5f7fa; }
.section-title { font-size: 28rpx; color: #5a6478; font-weight: 600; margin: 16rpx 8rpx; }
.stat-grid { display: flex; flex-wrap: wrap; background: #fff; border-radius: 16rpx; padding: 16rpx 0; box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.05); }
.stat { width: 50%; display: flex; flex-direction: column; align-items: center; padding: 24rpx 0; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #1677ff; }
.stat-label { font-size: 24rpx; color: #8a94a6; margin-top: 8rpx; }
.card { margin-top: 8rpx; background: #fff; border-radius: 16rpx; padding: 8rpx 28rpx; box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.05); }
.row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.row:last-child { border-bottom: none; }
.rk { font-size: 28rpx; color: #5a6478; }
.rv { font-size: 28rpx; color: #1f2a44; }
