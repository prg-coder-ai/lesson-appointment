<view class="page">
  <view class="page-head">
    <view class="page-title">数据总览</view>
    <view class="page-sub">{{isPlatform ? '平台运营概览（按月统计）' : '本公司运营概览（按月统计）'}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:else>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat-num">{{stat.teacher != null ? stat.teacher : '-'}}</view>
        <view class="stat-label">{{terms.teacher}}总数</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.student != null ? stat.student : '-'}}</view>
        <view class="stat-label">{{terms.student}}总数</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.course != null ? stat.course : '-'}}</view>
        <view class="stat-label">{{terms.course}}总数</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.booking != null ? stat.booking : '-'}}</view>
        <view class="stat-label">本月预订量</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.appoint != null ? stat.appoint : '-'}}</view>
        <view class="stat-label">本月预约人课次</view>
      </view>
    </view>

    <view class="section-title">待审核</view>
    <!-- 平台管理员：只列「新自注册租户」及其管理员账号个数（2026-11-05 定案方案一）。
         两行只读、不 bindtap —— 平台端暂无对应审批页，避免点了无反应；
         租户管理员走 wx:else 的原 5 行与跳转，逻辑一字不动。 -->
    <view wx:if="{{isPlatform}}" class="card">
      <view class="row">
        <text class="rk">新自注册租户</text>
        <text class="rv">{{platformPending.newTenants}}</text>
      </view>
      <view class="row">
        <text class="rk">其管理员账号</text>
        <text class="rv">{{platformPending.admins}}</text>
      </view>
    </view>
    <view wx:else class="card">
      <view class="row" bindtap="goAudit" data-status="booking">
        <text class="rk">预订</text>
        <text class="rv">{{pending.booking}}</text>
      </view>
      <view class="row" bindtap="goAudit" data-status="cancelling">
        <text class="rk">取消预订</text>
        <text class="rv">{{pending.cancelling}}</text>
      </view>
      <!-- 后三行跳「上课通知」：改期待确认按课次状态预筛 + days=0（与角标的全时段口径对齐）；
           「今日课程」不带参 → 上课通知缺省页面（全部状态 · 近 1 天） -->
      <view class="row" bindtap="goLessonNotice" data-status="cancelling" data-days="0">
        <text class="rk">{{terms.student}}改期</text>
        <text class="rv">{{pending.rescheduleStudent}}</text>
      </view>
      <view class="row" bindtap="goLessonNotice" data-status="t-cancelling" data-days="0">
        <text class="rk">{{terms.teacher}}改期</text>
        <text class="rv">{{pending.rescheduleTeacher}}</text>
      </view>
      <view class="row" bindtap="goLessonNotice">
        <text class="rk">今日{{terms.course}}</text>
        <text class="rv">{{pending.today}}</text>
      </view>
    </view>
  </block>

  <role-tabbar active="dashboard" bind:change="onTabChange" />
</view>
