<view class="page">
  <view class="page-head">
    <view class="page-title">数据总览</view>
    <view class="page-sub">本租户运营概览（按月统计）</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:else>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat-num">{{stat.teacher != null ? stat.teacher : '-'}}</view>
        <view class="stat-label">总教师数</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.student != null ? stat.student : '-'}}</view>
        <view class="stat-label">总学生数</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.course != null ? stat.course : '-'}}</view>
        <view class="stat-label">总课程数</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.booking != null ? stat.booking : '-'}}</view>
        <view class="stat-label">本月预定量</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stat.appoint != null ? stat.appoint : '-'}}</view>
        <view class="stat-label">本月预约课时</view>
      </view>
    </view>

    <view class="section-title">待处理</view>
    <view class="card">
      <view class="row" bindtap="goAudit" data-status="booking">
        <text class="rk">预约待确认</text>
        <text class="rv">{{pending.booking}}</text>
      </view>
      <view class="row" bindtap="goAudit" data-status="cancelling">
        <text class="rk">取消待确认</text>
        <text class="rv">{{pending.cancelling}}</text>
      </view>
      <view class="row">
        <text class="rk">今日课程</text>
        <text class="rv">{{pending.today}}</text>
      </view>
    </view>
  </block>

  <role-tabbar active="dashboard" bind:change="onTabChange" />
</view>
