<view class="page">
  <view class="bar">
    <text class="bar-title">课程列表</text>
    <text class="bar-count">共 {{total}} 门</text>
  </view>

  <view wx:if="{{loading}}" class="center">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="center">暂无课程</view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="row1">
        <text class="name">{{item.name}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="row2">
        <text class="meta">{{terms.teacher}} {{item.teacher || '-'}}</text>
        <text class="meta">等级 {{item.level || '-'}}</text>
      </view>
    </view>
  </view>
</view>
