<view class="page">
  <view class="bar"><text class="bar-title">{{terms.course}}排期</text></view>

  <view wx:if="{{loading}}" class="center">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="center">暂无排期</view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="row1">
        <text class="name">{{item.title}}</text>
        <text class="status {{item.status === 'active' ? 'ok' : (item.status === 'frozen' ? 'off' : '')}}">{{item.statusText}}</text>
      </view>
      <view class="row2"><text class="meta">{{terms.teacher}} {{item.teacher || '-'}}</text></view>
      <view class="row2"><text class="meta">时间 {{item.range || '-'}}</text></view>
    </view>
  </view>
</view>
