<view class="page">
  <view class="header">
    <view class="greet">{{user.name || user.account}}</view>
    <view class="sub">{{roleText}} · 租户 {{user.tenantCode}}</view>
  </view>

  <view wx:for="{{groups}}" wx:key="title" wx:for-item="g" class="group">
    <view class="group-title">{{g.title}}</view>
    <view class="grid">
      <view
        wx:for="{{g.items}}" wx:key="text" wx:for-item="it"
        class="grid-item"
        data-page="{{it.page}}"
        bindtap="onTapItem">
        <view class="gi-text">{{it.text}}</view>
        <view wx:if="{{it.page === '/package-message/inbox/inbox' && unreadCount > 0}}" class="gi-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
    </view>
  </view>

  <role-tabbar active="home" bind:change="onTabChange" />
</view>
