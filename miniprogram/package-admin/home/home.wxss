.page { min-height: 100vh; padding: 32rpx 32rpx 140rpx; box-sizing: border-box; background: #f5f7fa; }
.header { padding: 24rpx 8rpx 8rpx; }
.greet { font-size: 40rpx; font-weight: 700; color: #1f2a44; }
.sub { font-size: 26rpx; color: #6b7587; margin-top: 8rpx; }
.group { margin-top: 28rpx; }
.group-title { font-size: 26rpx; color: #6b7587; font-weight: 600; margin: 0 8rpx 12rpx; }
.grid {
  display: flex; flex-wrap: wrap;
  background: #fff; border-radius: 20rpx; padding: 20rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.05);
}
.grid-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 24rpx 0; position: relative; }
.gi-text { font-size: 26rpx; color: #5a6478; margin-top: 0; text-align: center; }
/* 仅展示菜单（功能建设中）：淡化并以小标签提示，点击走 onTapItem 的"建设中"提示 */
.gi-disabled { opacity: 0.55; }
.gi-soon {
  position: absolute; top: 8rpx; right: 30rpx;
  padding: 0 8rpx; height: 26rpx; line-height: 26rpx;
  background: #eef1f6; color: #8a94a6; font-size: 18rpx; border-radius: 13rpx; text-align: center;
}
.gi-badge {
  position: absolute; top: 10rpx; right: 36rpx; min-width: 30rpx; height: 30rpx; line-height: 30rpx;
  padding: 0 8rpx; background: #fa5151; color: #fff; font-size: 20rpx; border-radius: 15rpx; text-align: center;
}
