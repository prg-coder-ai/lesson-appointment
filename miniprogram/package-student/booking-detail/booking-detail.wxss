.page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; background: #f5f7fa; }
.hero { background: linear-gradient(135deg, #1677ff, #4096ff); border-radius: 20rpx; padding: 36rpx 32rpx; color: #fff; }
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.9; margin-top: 10rpx; }
.card { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.05); }
.card-title { font-size: 30rpx; font-weight: 600; color: #1f2a44; margin-bottom: 16rpx; }
.card-text { font-size: 27rpx; color: #5a6478; line-height: 1.7; }
.empty { font-size: 26rpx; color: #aab2c0; padding: 24rpx 0; text-align: center; }
.sched { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.sched:last-child { border-bottom: none; }
.sched-time { font-size: 28rpx; color: #1f2a44; }
.sched-left { font-size: 24rpx; color: #8a94a6; margin-top: 6rpx; }
.btn-book { background: #1677ff; color: #fff; font-size: 24rpx; }
.btn-book::after { border: none; }
