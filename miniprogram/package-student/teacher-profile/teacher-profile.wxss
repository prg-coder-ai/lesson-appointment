.page { min-height: 100vh; background: #f5f7fa; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; }
.tip { text-align: center; color: #99a; padding: 60rpx 0; font-size: 26rpx; }
.empty { text-align: center; color: #99a; padding: 120rpx 48rpx; font-size: 27rpx; line-height: 1.6; }
.empty-glyph { font-size: 80rpx; margin-bottom: 16rpx; }

.hero { background: #fff; border-radius: 16rpx; padding: 40rpx 28rpx; text-align: center; box-shadow: 0 2rpx 10rpx rgba(30,50,90,.06); }
/* 封面用后端给的 CSS background（coverUrl 形如 url(...)），缺失时由 JS 塞渐变 */
.hero-cover { width: 140rpx; height: 140rpx; border-radius: 24rpx; margin: 0 auto 20rpx;
  display: flex; align-items: center; justify-content: center; overflow: hidden; }
.hero-initial { color: #fff; font-size: 60rpx; font-weight: 700; }
.hero-name { font-size: 36rpx; font-weight: 700; color: #1f2a4d; }
/* 职业信息标题（核心展示） */
.hero-title { font-size: 26rpx; color: #4e6ef2; margin-top: 10rpx; line-height: 1.5; }

.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 2rpx 10rpx rgba(30,50,90,.06); }
.card-title { font-size: 28rpx; font-weight: 600; color: #1f2a4d; margin-bottom: 12rpx; }
.card-text { font-size: 26rpx; color: #556; line-height: 1.7; white-space: pre-wrap; }

.actions { margin-top: 32rpx; }
.btn-primary { background: #4e6ef2; color: #fff; border-radius: 12rpx; font-size: 29rpx; }
