<view class="page">
  <view class="topbar">
    <!-- 标题里的「课程」走行业词（法律/心理行业渲染为「今日咨询话题 / 今日咨询项目」） -->
    <view class="tb-title">今日{{terms.course}}</view>
    <view class="tb-days">
      <text class="day {{days===1?'on':''}}" data-days="1" bindtap="onDayChange">1天</text>
      <text class="day {{days===3?'on':''}}" data-days="3" bindtap="onDayChange">3天</text>
      <text class="day {{days===7?'on':''}}" data-days="7" bindtap="onDayChange">7天</text>
      <text class="day {{days===-1?'on':''}}" data-days="-1" bindtap="onDayChange">全部</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{list.length===0}}" class="empty">
    <view class="empty-glyph">📚</view>
    <view>近期没有{{terms.course}}安排</view>
  </view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="item">
      <view class="it-top">
        <text class="it-title">{{item.title}}</text>
        <text class="it-status s-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="it-sub">{{item.sub}}</view>
      <view class="it-time" wx:if="{{item.time}}">🕒 {{item.time}}</view>
      <!-- 在线课堂（2026-11-21）：按课次阶段给按钮；小程序内「进入课堂」= 说明 + 复制链接 -->
      <view class="it-ops" wx:if="{{item.classroom && item.classroom.actions.length}}">
        <text
          wx:for="{{item.classroom.actions}}" wx:key="action" wx:for-item="a"
          class="op {{a.action === 'enter' ? 'primary' : ''}}"
          data-action="{{a.action}}"
          data-key="{{item.classroom.key}}"
          data-name="{{item.title}}"
          bindtap="onClassroom">{{a.label}}</text>
      </view>
    </view>
  </view>

  <role-tabbar active="appointment" bind:change="onTabChange" />
</view>
