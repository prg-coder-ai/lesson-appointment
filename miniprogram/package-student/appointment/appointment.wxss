.page { min-height: 100vh; background: #f5f7fa; padding-bottom: 20rpx; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx 12rpx; }
.tb-title { font-size: 34rpx; font-weight: 600; color: #1f2a4d; }
.tb-days { display: flex; }
.day { font-size: 24rpx; color: #667; padding: 6rpx 16rpx; margin-left: 8rpx; background: #fff; border-radius: 24rpx; }
.day.on { color: #fff; background: #4e6ef2; }

.tip { text-align: center; color: #99a; padding: 40rpx 0; font-size: 26rpx; }
.empty { text-align: center; color: #99a; padding: 90rpx 0; }
.empty-glyph { font-size: 80rpx; margin-bottom: 16rpx; }

.list { padding: 8rpx 24rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(30,50,90,.06); }
.it-top { display: flex; align-items: center; justify-content: space-between; }
.it-title { font-size: 30rpx; font-weight: 600; color: #1f2a4d; }
.it-status { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 20rpx; background: #eef1f7; color: #5a6472; }
.it-status.s-active, .it-status.s-booked { color: #3a8a3a; background: #e7f6e7; }
.it-status.s-cancelled, .it-status.s-t-cancelled, .it-status.s-t-reject { color: #c0392b; background: #fdecea; }
.it-status.s-completed { color: #8a6d00; background: #fff7e0; }
.it-status.s-s-cancelling, .it-status.s-t-cancelling { color: #c0871b; background: #fff3e0; }
.it-sub { font-size: 26rpx; color: #667; margin-top: 8rpx; }
.it-time { font-size: 24rpx; color: #889; margin-top: 6rpx; }

/* 在线课堂按钮（2026-11-21）：课次维度的进入课堂/课程回看 */
.it-ops { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #f0f2f6; }
.op { font-size: 24rpx; color: #475467; border: 1rpx solid #e4e7ec; border-radius: 8rpx; padding: 8rpx 20rpx; }
.op.primary { color: #fff; background: #1677ff; border-color: #1677ff; }
