<view class="page">
  <view wx:if="{{list.length===0 && !loading}}" class="empty">还没有预约记录</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="bookingId" class="item">
      <view class="item-main">
        <view class="item-title">{{item.courseTitle || item.title || ('预约 ' + (item.scheduleId || ''))}}</view>
        <view class="item-sub">{{item.teacherName || ''}} · {{item.timeText || ''}}</view>
      </view>
      <view class="item-right">
        <text class="status {{canCancel ? 'st-active' : ''}}">{{item.statusText}}</text>
        <text wx:if="{{canCancel}}" class="btn-cancel" data-id="{{item.bookingId}}" bindtap="cancel">取消</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="foot">加载中...</view>

  <role-tabbar active="my" bind:change="onTabChange" />
</view>
