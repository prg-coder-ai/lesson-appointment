<view class="page">
  <view class="topbar">
    <view class="tb-title">{{terms.teacher || '教师'}}列表</view>
    <view class="tb-sub">以下为本机构已发布的{{terms.teacher || '教师'}}职业信息</view>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{list.length===0}}" class="empty">
    <view class="empty-glyph">👥</view>
    <view>{{emptyText}}</view>
  </view>
  <view wx:else class="cards">
    <view wx:for="{{list}}" wx:key="pid" class="card" data-pid="{{item.pid}}" data-tid="{{item.teacherId}}" bindtap="goProfile"
          hover-class="card-hover" hover-stay-time="60">
      <view class="card-cover" style="{{item.coverStyle}}">
        <text class="card-initial">{{item.initial}}</text>
      </view>
      <view class="card-body">
        <view class="card-name">{{item.name}}</view>
        <view class="card-title" wx:if="{{item.title}}">{{item.title}}</view>
        <view class="card-summary">{{item.summary || '暂无简介'}}</view>
      </view>
      <view class="card-arrow">›</view>
    </view>
  </view>

  <role-tabbar active="home" bind:change="onTabChange" />
</view>
