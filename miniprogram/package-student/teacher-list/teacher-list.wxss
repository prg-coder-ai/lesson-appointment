.page { min-height: 100vh; background: #f5f7fa; padding-bottom: 140rpx; box-sizing: border-box; }
.topbar { padding: 24rpx 28rpx 12rpx; }
.tb-title { font-size: 34rpx; font-weight: 600; color: #1f2a4d; }
.tb-sub { font-size: 23rpx; color: #98a2b3; margin-top: 8rpx; }

.tip { text-align: center; color: #99a; padding: 40rpx 0; font-size: 26rpx; }
.empty { text-align: center; color: #99a; padding: 90rpx 48rpx; line-height: 1.6; font-size: 27rpx; }
.empty-glyph { font-size: 80rpx; margin-bottom: 16rpx; }

.cards { padding: 8rpx 24rpx; }
.card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(30,50,90,.06); }
.card-hover { background: #fafbfd; }
/* 封面：直接用后端给的 CSS background（coverUrl 形如 url(...)），缺失时由 JS 塞渐变 */
.card-cover { width: 96rpx; height: 96rpx; border-radius: 16rpx; flex: none; margin-right: 20rpx;
  display: flex; align-items: center; justify-content: center; overflow: hidden; }
.card-initial { color: #fff; font-size: 40rpx; font-weight: 700; }
.card-body { flex: 1; min-width: 0; }
.card-name { font-size: 30rpx; font-weight: 600; color: #1f2a4d; }
/* 职业信息标题：后端实体独立列，发布时填写 —— 本页的核心展示内容 */
.card-title { font-size: 24rpx; color: #4e6ef2; margin-top: 6rpx; line-height: 1.4; }
.card-summary { font-size: 24rpx; color: #889; margin-top: 8rpx; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-arrow { color: #c0c5cf; font-size: 40rpx; margin-left: 12rpx; }
