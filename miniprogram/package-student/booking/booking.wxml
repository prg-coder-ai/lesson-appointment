<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索课程 / 教师" value="{{keyword}}" bindinput="onSearch" bindconfirm="onConfirmSearch" confirm-type="search" />
  </view>

  <view wx:if="{{list.length===0 && !loading}}" class="empty">暂无可选课程</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="courseId" class="item" data-id="{{item.courseId}}" bindtap="goDetail">
      <view class="item-main">
        <view class="item-title">{{item.title || item.courseName || '未命名课程'}}</view>
        <view class="item-sub">{{item.teacherName || item.teacherId || ''}} · {{item.subject || ''}}</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="foot">加载中...</view>
  <view wx:if="{{finished && list.length>0}}" class="foot">没有更多了</view>

  <role-tabbar active="booking" bind:change="onTabChange" />
</view>
