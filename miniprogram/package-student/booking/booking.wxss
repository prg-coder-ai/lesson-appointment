.page { min-height: 100vh; padding: 24rpx 24rpx 140rpx; box-sizing: border-box; background: #f5f7fa; }
.search-bar { margin-bottom: 20rpx; }
.search-input { height: 76rpx; background: #fff; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; box-shadow: 0 4rpx 16rpx rgba(31,42,68,0.04); }
.empty { text-align: center; color: #aab2c0; font-size: 28rpx; padding: 120rpx 0; }
.list { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 8rpx 30rpx rgba(31,42,68,0.05); }
.item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f2f5; }
.item:last-child { border-bottom: none; }
.item-title { font-size: 30rpx; color: #1f2a44; font-weight: 500; }
.item-sub { font-size: 24rpx; color: #8a94a6; margin-top: 8rpx; }
.item-arrow { color: #c0c6d0; font-size: 36rpx; }
.foot { text-align: center; color: #aab2c0; font-size: 24rpx; padding: 24rpx 0; }
