.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #eceff3;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a94a6;
  font-size: 22rpx;
}
.tab-item.active { color: #1677ff; }
.tab-glyph {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}
.tab-text {
  line-height: 1;
  /* 标签经行业词转换后可能变长（如「我的咨询话题」6 字），禁止折行、超长省略 */
  max-width: 100%;
  padding: 0 6rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
