{
  "name": "lesson-classroom-crossplatform",
  "version": "1.0.0",
  "private": true,
  "description": "课堂独立一码多端框架：一套 Web 代码，运行于浏览器 / iOS / Android（Capacitor 套壳），师生管三角色共用",
  "scripts": {
    "sync": "node scripts/sync.js",
    "patch:check": "node scripts/patch.js --check",
    "build": "node scripts/build.js",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "dev:web": "node scripts/serve.js",
    "verify:web": "node scripts/serve.js 8098",
    "build:local": "APP_MODE=local node scripts/build.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/app": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  }
}
